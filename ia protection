-- drag
local dragging, dragStart, startPos
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging   = true
        dragStart  = input.Position
        startPos   = main.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- ctrl + wheel to resize
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
    local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
              or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
    if not ctrl then return end
    uiScale.Scale = math.clamp(uiScale.Scale + input.Position.Z * 0.05, 0.5, 2.5)
end)

-- toggles
local function makeToggle(order, labelText, getState, setState)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(1, -16, 0, 32)
    btn.Position         = UDim2.new(0, 8, 0, 34 + (order - 1) * 38)
    btn.BackgroundColor3 = Color3.fromRGB(45, 48, 52)
    btn.BorderSizePixel  = 0
    btn.AutoButtonColor  = false
    btn.Text             = ""
    btn.Parent           = main

    local cr = Instance.new("UICorner")
    cr.CornerRadius = UDim.new(0, 6)
    cr.Parent = btn

    local lbl = Instance.new("TextLabel")
    lbl.Size               = UDim2.new(1, -80, 1, 0)
    lbl.Position           = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font               = Enum.Font.GothamMedium
    lbl.TextSize           = 12
    lbl.TextColor3         = Color3.fromRGB(220, 220, 220)
    lbl.TextXAlignment     = Enum.TextXAlignment.Left
    lbl.Text               = labelText
    lbl.Parent             = btn

    local state = Instance.new("TextLabel")
    state.Size               = UDim2.new(0, 60, 1, 0)
    state.Position           = UDim2.new(1, -72, 0, 0)
    state.BackgroundTransparency = 1
    state.Font               = Enum.Font.GothamBold
    state.TextSize           = 12
    state.TextXAlignment     = Enum.TextXAlignment.Right
    state.Parent             = btn

    local function refresh()
        if getState() then
            state.Text       = "ON"
            state.TextColor3 = Color3.fromRGB(80, 200, 120)
        else
            state.Text       = "OFF"
            state.TextColor3 = Color3.fromRGB(120, 120, 120)
        end
    end
    refresh()

    btn.MouseButton1Click:Connect(function()
        setState(not getState())
        refresh()
    end)

    return btn
end

