-- RESPAWN HANDLING
-- ============================================================
player.CharacterAdded:Connect(function(c)
    local h = c:WaitForChild("Humanoid", 5)
    local r = c:WaitForChild("HumanoidRootPart", 5)
    if not h or not r then return end
    if AntiSit.enabled       then bindAntiSit(c, h, r) end
    if AntiFling.enabled     then bindAntiFling(c, h, r) end
    if AntiCollision.enabled then bindAntiCollision(c) end
end)

