--[[
    Hacking Everything: client-side anti-sit / anti-fling / anti-collision
    target executor: Xeno (PC, AZERTY). toggle key: RightAlt.

    sources:
    - anti-sit:
        myCompiler "Brookhaven script" (SetStateEnabled(Seated,false) + Sit loop)
        ScriptBlox "Universal Script | Anti sit script" (Seat/VehicleSeat neutralise + Sit hook)
    - anti-fling:
        RedstoneAC (ScriptBlox) (velocity/spin clear, BodyMover purge)
        DevForum "Cheaters throw players off the map" (HRP sanity check)
    - anti-collision:
        ScriptBlox "Universal Script | Noclip" (GetPropertyChangedSignal hook)
        DevForum "Noclip Prevention" (server may reset CanCollide -> force back)

    honest limits:
    - server authority (Roblox 2026+) can roll back any client correction.
    - server-side raycast between positions beats client noclip; you
      cannot prevent a server rollback, only delay it locally.
    - anti-fling cannot stop a teleport the server performs; it can only
      put you back on the next tick.
]]

local Players         = game:GetService("Players")
local RunService      = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace       = game:GetService("Workspace")

local player     = Players.LocalPlayer
local playerGui  = player:WaitForChild("PlayerGui")

local TOGGLE_KEY = Enum.KeyCode.RightAlt

local function disconnectAll(list)
    for i = #list, 1, -1 do
        pcall(function() list[i]:Disconnect() end)
        list[i] = nil
    end
end

local function getCharacterParts()
    local c = player.Character
    if not c then return nil, nil, nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    return c, h, r
end

-- ============================================================
-- MODULE 1: ANTI-SIT
-- ============================================================
local AntiSit = {
    enabled = false,
    token   = 0,
    charConns = {},
    descConn  = nil,
    seatOriginals = {},
}

local function isSeat(inst)
    return inst:IsA("Seat") or inst:IsA("VehicleSeat")
end

local function neutralizeSeat(seat)
    if AntiSit.seatOriginals[seat] == nil then
        AntiSit.seatOriginals[seat] = {
            disabled  = seat.Disabled,
            canTouch  = seat.CanTouch,
        }
    end
    pcall(function() seat.Disabled = true  end)
    pcall(function() seat.CanTouch = false end)
end

local function restoreSeat(seat)
    local orig = AntiSit.seatOriginals[seat]
    if not orig then return end
    pcall(function() seat.Disabled = orig.disabled end)
    pcall(function() seat.CanTouch = orig.canTouch end)
    AntiSit.seatOriginals[seat] = nil
end

local function restoreAllSeats()
    for seat in pairs(AntiSit.seatOriginals) do
        if seat then restoreSeat(seat) end
    end
    AntiSit.seatOriginals = {}
end

local function bindAntiSit(c, h, r)
    disconnectAll(AntiSit.charConns)
    AntiSit.token = AntiSit.token + 1
    local myToken = AntiSit.token
    if not h then return end

    pcall(function()
        h:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    end)

    table.insert(AntiSit.charConns, h:GetPropertyChangedSignal("Sit"):Connect(function()
        if not AntiSit.enabled then return end
        if h.Sit then pcall(function() h.Sit = false end) end
    end))

    table.insert(AntiSit.charConns, h.StateChanged:Connect(function(_, new)
        if not AntiSit.enabled then return end
        if new == Enum.HumanoidStateType.Seated then
            pcall(function() h:ChangeState(Enum.HumanoidStateType.Jumping) end)
        end
    end))

    task.spawn(function()
        while AntiSit.enabled and AntiSit.token == myToken do
            if not h.Parent then break end
            pcall(function() h.Sit = false end)
            task.wait(0.05)
        end
    end)
end

local function enableAntiSit()
    if AntiSit.enabled then return end
    AntiSit.enabled = true

    task.spawn(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if isSeat(d) then neutralizeSeat(d) end
        end
    end)

    if not AntiSit.descConn then
        AntiSit.descConn = Workspace.DescendantAdded:Connect(function(d)
            if not AntiSit.enabled then return end
            if isSeat(d) then neutralizeSeat(d) end
        end)
    end

    local c, h, r = getCharacterParts()
    bindAntiSit(c, h, r)
end

local function disableAntiSit()
    if not AntiSit.enabled then return end
    AntiSit.enabled = false
    AntiSit.token = AntiSit.token + 1
    disconnectAll(AntiSit.charConns)

    local _, h = getCharacterParts()
    if h then
        pcall(function()
            h:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        end)
    end

    if AntiSit.descConn then
        AntiSit.descConn:Disconnect()
        AntiSit.descConn = nil
    end

    restoreAllSeats()
end

-- ============================================================
-- MODULE 2: ANTI-FLING
-- ============================================================
local AntiFling = {
    enabled = false,
    token   = 0,
    charConns = {},
    lastSafe  = nil,
}

local FLING_MAX_LIN        = 100
local FLING_MAX_ANG        = 50
local FLING_MAX_TELEPORT   = 50
local FLING_MAX_FORCE      = 1e7

local function isSuspectBodyMover(inst)
    return inst:IsA("BodyVelocity")
        or inst:IsA("BodyThrust")
        or inst:IsA("BodyAngularVelocity")
        or inst:IsA("BodyForce")
        or inst:IsA("BodyPosition")
        or inst:IsA("BodyGyro")
end

local function isSuspectConstraint(inst)
    if inst:IsA("AlignPosition") or inst:IsA("LinearVelocity") then
        local ok, mag = pcall(function() return inst.MaxForce.Magnitude end)
        return ok and mag > FLING_MAX_FORCE
    elseif inst:IsA("VectorForce") then
        local ok, mag = pcall(function() return inst.Force.Magnitude end)
        return ok and mag > FLING_MAX_FORCE
    end
    return false
end

local function purgeSuspicious(c)
    if not c then return end
    for _, inst in ipairs(c:GetDescendants()) do
        if isSuspectBodyMover(inst) or isSuspectConstraint(inst) then
            pcall(function() inst:Destroy() end)
        end
    end
end

local function startFlingWatch(c, h, r)
    local myToken = AntiFling.token
    task.spawn(function()
        while AntiFling.enabled and AntiFling.token == myToken do
            if not (r and r.Parent and h and h.Parent) then break end

            pcall(function()
                if r.AssemblyLinearVelocity.Magnitude > FLING_MAX_LIN then
                    r.AssemblyLinearVelocity = Vector3.zero
                end
                if r.AssemblyAngularVelocity.Magnitude > FLING_MAX_ANG then
                    r.AssemblyAngularVelocity = Vector3.zero
                end

                local pos = r.Position
                local delta = (pos - AntiFling.lastSafe).Magnitude
                if delta > FLING_MAX_TELEPORT then
                    r.CFrame = CFrame.new(AntiFling.lastSafe + Vector3.new(0, 5, 0))
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                else
                    AntiFling.lastSafe = pos
                end
            end)

            purgeSuspicious(c)
            task.wait(0.1)
        end
    end)
end

local function bindAntiFling(c, h, r)
    disconnectAll(AntiFling.charConns)
    AntiFling.token = AntiFling.token + 1
    if not (c and r and h) then return end
    AntiFling.lastSafe = r.Position

    table.insert(AntiFling.charConns, c.ChildAdded:Connect(function(inst)
        if not AntiFling.enabled then return end
        if isSuspectBodyMover(inst) or isSuspectConstraint(inst) then
            pcall(function() inst:Destroy() end)
        end
    end))

    startFlingWatch(c, h, r)
end

local function enableAntiFling()
    if AntiFling.enabled then return end
    AntiFling.enabled = true
    local c, h, r = getCharacterParts()
    bindAntiFling(c, h, r)
end

local function disableAntiFling()
    if not AntiFling.enabled then return end
    AntiFling.enabled = false
    AntiFling.token = AntiFling.token + 1
    disconnectAll(AntiFling.charConns)
    AntiFling.lastSafe = nil
end

-- ============================================================
-- MODULE 3: ANTI-COLLISION (NOCLIP)
-- ============================================================
local AntiCollision = {
    enabled   = false,
    watchToken = 0,
    charConns = {},
    runConns  = {},
    partConns = {},
    originals = setmetatable({}, { __mode = "k" }),
    locked    = setmetatable({}, { __mode = "k" }),
}

local function lockPart(part)
    if not (part and part:IsA("BasePart")) then return end
    if not AntiCollision.enabled then return end

    if AntiCollision.originals[part] == nil then
        AntiCollision.originals[part] = part.CanCollide
    end
    if part.CanCollide then
        pcall(function() part.CanCollide = false end)
    end
    if AntiCollision.locked[part] then return end
    AntiCollision.locked[part] = true

    local ok, conn = pcall(function()
        return part:GetPropertyChangedSignal("CanCollide"):Connect(function()
            if not AntiCollision.enabled then return end
            if part.CanCollide then
                pcall(function() part.CanCollide = false end)
            end
        end)
    end)
    if ok and conn then
        table.insert(AntiCollision.partConns, conn)
    end
end

local function sweepCharacter()
    if not AntiCollision.enabled then return end
    local c = player.Character
    if not c then return end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") then lockPart(d) end
    end
end

local function bindAntiCollision(c)
    disconnectAll(AntiCollision.charConns)
    for _, conn in ipairs(AntiCollision.partConns) do
        pcall(function() conn:Disconnect() end)
    end
    AntiCollision.partConns = {}
    AntiCollision.originals = setmetatable({}, { __mode = "k" })
    AntiCollision.locked    = setmetatable({}, { __mode = "k" })

    if not c then return end
    table.insert(AntiCollision.charConns, c.DescendantAdded:Connect(function(d)
        if not AntiCollision.enabled then return end
        if d:IsA("BasePart") then lockPart(d) end
    end))
    sweepCharacter()
end

local function enableAntiCollision()
    if AntiCollision.enabled then return end
    AntiCollision.enabled = true
    AntiCollision.watchToken = AntiCollision.watchToken + 1
    local myToken = AntiCollision.watchToken

    table.insert(AntiCollision.runConns, RunService.Stepped:Connect(sweepCharacter))
    table.insert(AntiCollision.runConns, RunService.Heartbeat:Connect(sweepCharacter))
    table.insert(AntiCollision.runConns, RunService.RenderStepped:Connect(sweepCharacter))

    task.spawn(function()
        while AntiCollision.enabled and AntiCollision.watchToken == myToken do
            pcall(sweepCharacter)
            task.wait(0.25)
        end
    end)

    bindAntiCollision(player.Character)
end

local function disableAntiCollision()
    if not AntiCollision.enabled then return end
    AntiCollision.enabled = false
    AntiCollision.watchToken = AntiCollision.watchToken + 1
    disconnectAll(AntiCollision.runConns)
    disconnectAll(AntiCollision.charConns)

    for _, conn in ipairs(AntiCollision.partConns) do
        pcall(function() conn:Disconnect() end)
    end
    AntiCollision.partConns = {}

    for part, orig in pairs(AntiCollision.originals) do
        if part and part.Parent then
            pcall(function() part.CanCollide = orig end)
        end
    end
    AntiCollision.originals = setmetatable({}, { __mode = "k" })
    AntiCollision.locked    = setmetatable({}, { __mode = "k" })
end

