-- ============================================================
-- Camera fallback
-- ============================================================
local function cameraFallback()
    if cameraFallbackActive then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    cameraFallbackActive = true
    local originalCFrame = camera.CFrame
    local startTime = os.clock()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if os.clock() - startTime < 0.06 then
            camera.CFrame = originalCFrame * CFrame.Angles(0, math.rad(0.35), 0)
        else
            camera.CFrame = originalCFrame
            cameraFallbackActive = false
            if conn then conn:Disconnect(); conn = nil end
        end
    end)
end

-- ============================================================
-- Click chain
-- ============================================================
local function performClick()
    if VirtualUser then
        pcall(function() VirtualUser:CaptureController() end)
        if pcall(function() VirtualUser:ClickButton2(Vector2.new()) end) then return true end
        if pcall(function() VirtualUser:ClickButton1(Vector2.new()) end) then return true end
        local downOk = pcall(function() VirtualUser:Button1Down(Vector2.new()) end)
        if downOk then
            task.wait(0.03)
            if pcall(function() VirtualUser:Button1Up(Vector2.new()) end) then return true end
        end
    end
    if ENABLE_CAMERA_FALLBACK then
        cameraFallback()
        return true
    end
    return false
end

-- ============================================================
-- UI update
-- ============================================================
local function updateUI()
    if enabled then
        statusLabel.Text = "Status: Enabled"
        statusLabel.TextColor3 = Color3.fromRGB(90, 220, 130)
        toggleBtn.Text = "ON"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 170, 90)
    else
        statusLabel.Text = "Status: Disabled"
        statusLabel.TextColor3 = Color3.fromRGB(220, 90, 90)
        toggleBtn.Text = "OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(90, 90, 100)
    end
    camBtn.Text = "Cam: " .. (ENABLE_CAMERA_FALLBACK and "ON" or "OFF")
    camBtn.BackgroundColor3 = ENABLE_CAMERA_FALLBACK and Color3.fromRGB(80, 130, 200) or Color3.fromRGB(60, 60, 75)
    countLabel.Text = "Triggers: " .. tostring(triggerCount)
end

-- ============================================================
-- Idled
-- ============================================================
local function onIdled()
    if not enabled then return end
    local now = os.clock()
    if now - lastTrigger < SHORT_THROTTLE then return end
    lastTrigger = now
    triggerCount = triggerCount + 1
    print("[AntiAFK] triggered")
    updateUI()
    if not performClick() then
        print("[AntiAFK] click failed")
    end
end

-- ============================================================
-- Stop
-- ============================================================
local function stop()
    if idledConnection then idledConnection:Disconnect(); idledConnection = nil end
    if keyConnection then keyConnection:Disconnect(); keyConnection = nil end
    env.__XENO_ANTIAFK_LOADED = nil
    _G.__XENO_ANTIAFK_LOADED = nil
    env.__XENO_ANTIAFK_STOP = nil
    print("[AntiAFK] stopped")
    pcall(function() screenGui:Destroy() end)
end

