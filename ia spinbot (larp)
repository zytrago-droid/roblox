        BackgroundColor3 = Spinbot.enabled and C.accent or C.bgActive
    }):Play()
end))

bind(gui.methodBtn.MouseButton1Click:Connect(function()
    Spinbot.method = Spinbot.method == 1 and 2 or 1
    gui.methodBtn.Text = Spinbot.method == 1
        and "AssemblyAngularVelocity"
        or "AngularVelocity (constraint)"
    if Spinbot.enabled then
        applySpinbot()
    end
end))

bind(gui.methodBtn.MouseEnter:Connect(function()
    if gui then
        TweenService:Create(gui.methodBtn, TweenInfo.new(0.15),
            { BackgroundColor3 = C.bgHover }):Play()
    end
end))

bind(gui.methodBtn.MouseLeave:Connect(function()
    if gui then
        TweenService:Create(gui.methodBtn, TweenInfo.new(0.15),
            { BackgroundColor3 = C.bgActive }):Play()
    end
end))

-- ============================================================
-- CHARACTER HOOKS
-- ============================================================
local function onCharacterAdded(char)
    char:WaitForChild("HumanoidRootPart", 10)
    local hum = char:WaitForChild("Humanoid", 10)
    if Spinbot.enabled then
        task.wait(0.1)
        applySpinbot()
    end
    if hum then
        bind(hum.Died:Connect(disableSpinbot))
    end
end

bind(LocalPlayer.CharacterAdded:Connect(onCharacterAdded))
if LocalPlayer.Character then
    task.spawn(onCharacterAdded, LocalPlayer.Character)
end

-- ============================================================
-- KEYBIND
-- ============================================================
local TOGGLE_KEY = Enum.KeyCode.RightShift
if getgenv and getgenv().MenuKey == Enum.KeyCode.RightShift then
    TOGGLE_KEY = Enum.KeyCode.RightControl
end

bind(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or isShutdown then return end
    if input.KeyCode == TOGGLE_KEY then
        toggleSpinbot()
    end
end))

-- ============================================================
-- CTRL + MOLETTE
-- ============================================================
bind(UserInputService.InputChanged:Connect(function(input)
    if isShutdown or not gui then return end
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
            gui.uiScale.Scale = math.clamp(
                gui.uiScale.Scale + input.Position.Z * 0.05, 0.6, 1.6
            )
        end
    end
end))

