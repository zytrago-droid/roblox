    method     = 1,
    connection = nil,
    constraint = nil,
    attachment = nil,
}

local MIN_SPEED, MAX_SPEED  = 10, 500
local MAX_HORIZONTAL_SPEED  = 60
local MAX_SAFE_SPIN         = 300

local originalPhysProps = {}
local clampConn        = nil
local uprightConn      = nil
local allConnections   = {}
local gui              = nil
local isShutdown       = false

local function bind(conn)
    table.insert(allConnections, conn)
    return conn
end

-- ============================================================
-- UTILITAIRES
-- ============================================================
local function getRootAndHumanoid()
    local char = LocalPlayer.Character
    if not char then return nil, nil end
    return char:FindFirstChild("HumanoidRootPart"),
           char:FindFirstChildOfClass("Humanoid")
end

local function getAppliedSpeed()
    return math.min(Spinbot.speed, MAX_SAFE_SPIN)
end

-- ============================================================
-- ANTI-FLING : propriétés physiques
-- ============================================================
local function applyNoFlingProperties()
    originalPhysProps = {}
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                originalPhysProps[part] = part.CustomPhysicalProperties
                part.CustomPhysicalProperties =
                    PhysicalProperties.new(0.7, 0, 0, 100, 100)
            end)
        end
    end
end

local function restorePhysProperties()
    for part, props in pairs(originalPhysProps) do
        pcall(function()
            if part and part.Parent then
                part.CustomPhysicalProperties = props
            end
        end)
    end
    originalPhysProps = {}
end

-- ============================================================
-- ANTI-FLING : clamp vélocité horizontale
-- ============================================================
local function startVelocityClamp()
    if clampConn then clampConn:Disconnect() end
    clampConn = RunService.Heartbeat:Connect(function()
        if not Spinbot.enabled then return end
        local hrp = getRootAndHumanoid()
        if not hrp then return end
        local v  = hrp.AssemblyLinearVelocity
        local hv = Vector3.new(v.X, 0, v.Z)
        local limit = (Spinbot.speed > 100) and 30 or MAX_HORIZONTAL_SPEED
        if hv.Magnitude > limit then
            pcall(function()
                local clamped = hv.Unit * limit
                hrp.AssemblyLinearVelocity =
                    Vector3.new(clamped.X, v.Y, clamped.Z)
            end)
        end
    end)
end

local function stopVelocityClamp()
    if clampConn then
        clampConn:Disconnect()
        clampConn = nil
    end
end

-- ============================================================
-- STABILISATEUR UPRIGHT — "jamais tomber"
-- ============================================================
-- 1) Force l'humanoid hors des états de chute / ragdoll
-- 2) Corrige la CFrame si l'up vector dévie (roulis/tangage)
-- 3) Préserve les vélocités pour ne pas interférer avec le spin
local function startUprightStabilizer()
    if uprightConn then uprightConn:Disconnect() end
    uprightConn = RunService.Heartbeat:Connect(function()
        if not Spinbot.enabled then return end
        local hrp, hum = getRootAndHumanoid()
        if not hrp or not hum then return end

        -- A. Sortie forcée des états "au sol"
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.FallingDown
        or state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.GettingUp then
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end

        -- B. Correction d'orientation
        local cf = hrp.CFrame
        if cf.UpVector.Y < 0.995 then
            local av = hrp.AssemblyAngularVelocity
            local lv = hrp.AssemblyLinearVelocity
            local pos = cf.Position
            local look = cf.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude < 0.01 then
                flat = Vector3.new(0, 0, -1)
            else
                flat = flat.Unit
            end
            pcall(function()
                hrp.CFrame = CFrame.lookAt(pos, pos + flat, Vector3.yAxis)
                hrp.AssemblyAngularVelocity = av
                hrp.AssemblyLinearVelocity = lv
            end)
        end
    end)
end

local function stopUprightStabilizer()
    if uprightConn then
        uprightConn:Disconnect()
        uprightConn = nil
    end
end

-- ============================================================
-- FIX humanoid (états + AutoRotate)
-- ============================================================
local function applySpinGroundFix()
    local _, hum = getRootAndHumanoid()
    if not hum then return end
    pcall(function()
        hum.AutoRotate = false
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
    end)
end

local function restoreSpinGroundFix()
    local _, hum = getRootAndHumanoid()
    if not hum then return end
    pcall(function()
        hum.AutoRotate = true
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
    end)
end

-- ============================================================
-- MÉTHODES DE SPIN
-- ============================================================
local function startMethod1(hrp)
    if Spinbot.connection then Spinbot.connection:Disconnect() end
    Spinbot.connection = RunService.RenderStepped:Connect(function()
        if not Spinbot.enabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        pcall(function()
            root.AssemblyAngularVelocity = Vector3.new(0, getAppliedSpeed(), 0)
        end)
    end)
end

local function stopMethod1()
    if Spinbot.connection then
        Spinbot.connection:Disconnect()
        Spinbot.connection = nil
    end
end

local function stopMethod2()
    if Spinbot.constraint then
        pcall(function() Spinbot.constraint:Destroy() end)
        Spinbot.constraint = nil
    end
    if Spinbot.attachment then
        pcall(function() Spinbot.attachment:Destroy() end)
        Spinbot.attachment = nil
    end
end

local function startMethod2(hrp)
    stopMethod2()
    local att = Instance.new("Attachment")
    att.Name = "SpinbotAttachment"
    att.Parent = hrp
    local av = Instance.new("AngularVelocity")
    av.Name = "SpinbotAngularVelocity"
    av.Attachment0 = att
    av.MaxTorque = math.huge
    av.AngularVelocity = Vector3.new(0, getAppliedSpeed(), 0)
    av.RelativeTo = Enum.ActuatorRelativeTo.World
    av.Parent = hrp
    Spinbot.attachment = att
    Spinbot.constraint = av
end

-- ============================================================
-- STATUS
-- ============================================================
local function setStatus(text, color)
    if not gui then return end
    gui.statusLabel.Text = text
    gui.statusLabel.TextColor3 = color or C.textDim
    gui.statusDot.BackgroundColor3 = color or C.textDim
end

-- ============================================================
-- ACTIVATION / DÉSACTIVATION
-- ============================================================
local function applySpinbot()
    local hrp = getRootAndHumanoid()
    if not hrp then
        setStatus("fail: no character", C.danger)
        Spinbot.enabled = false
        if gui then
            gui.toggleBtn.Text = "SPINBOT OFF"
            TweenService:Create(gui.toggleBtn, TweenInfo.new(0.2),
                { BackgroundColor3 = C.bgActive }):Play()
        end
        return
    end
    stopMethod1()
    stopMethod2()
    if Spinbot.method == 1 then
        startMethod1(hrp)
    else
        startMethod2(hrp)
    end
    applyNoFlingProperties()
    startVelocityClamp()
    applySpinGroundFix()
    startUprightStabilizer()
    setStatus("spinning · debout", C.success)
end

local function disableSpinbot()
    Spinbot.enabled = false
    stopMethod1()
    stopMethod2()
    stopVelocityClamp()
    stopUprightStabilizer()
    restorePhysProperties()
    restoreSpinGroundFix()
    setStatus("ready", C.textDim)
end

local function toggleSpinbot()
    Spinbot.enabled = not Spinbot.enabled
    if gui then
        TweenService:Create(gui.toggleBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Spinbot.enabled and C.accent or C.bgActive
        }):Play()
        gui.toggleBtn.Text = Spinbot.enabled and "SPINBOT ON" or "SPINBOT OFF"
    end
    if Spinbot.enabled then
        applySpinbot()
    else
        disableSpinbot()
    end
end

-- ============================================================
-- SHUTDOWN COMPLET
-- ============================================================
local function fullCleanup()
    if isShutdown then return end
    isShutdown = true
    Spinbot.enabled = false

    if Spinbot.connection then
        pcall(function() Spinbot.connection:Disconnect() end)
        Spinbot.connection = nil
    end
    stopMethod2()
    stopVelocityClamp()
    stopUprightStabilizer()
    restorePhysProperties()
    restoreSpinGroundFix()

    for _, conn in ipairs(allConnections) do
        pcall(function() conn:Disconnect() end)
    end
    allConnections = {}

    if gui and gui.screenGui then
        pcall(function() gui.screenGui:Destroy() end)
        gui = nil
    end

    print("[Spinbot] Shutdown complet.")
end

