    cLayout.Padding = UDim.new(0, 6)
    cLayout.SortOrder = Enum.SortOrder.LayoutOrder
    cLayout.Parent = controls

    local function createControlBtn(text, order)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 88, 1, 0)
        b.BackgroundColor3 = THEME.ROW
        b.BorderSizePixel = 0
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.TextColor3 = THEME.SUBTEXT
        b.Text = text
        b.LayoutOrder = order
        b.Parent = controls
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = b
        createHoverEffect(b, THEME.ROW, THEME.ROW_HOVER)
        return b
    end

    bringAllBtn = createControlBtn("BRING ALL [G]", 1)
    loopBtn = createControlBtn("LOOP [L]", 2)
    noclipBtn = createControlBtn("NOCLIP [K]", 3)

    bringAllBtn.MouseButton1Click:Connect(function()
        bringAll()
        if bringAllActive then bringAllBtn.TextColor3 = THEME.ACCENT else bringAllBtn.TextColor3 = THEME.SUBTEXT end
    end)
    
    loopBtn.MouseButton1Click:Connect(function()
        bringAllLoop = not bringAllLoop
        if bringAllLoop then
            loopBtn.TextColor3 = THEME.SUCCESS
            TweenService:Create(loopBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 50, 35)}):Play()
        else
            loopBtn.TextColor3 = THEME.SUBTEXT
            TweenService:Create(loopBtn, TweenInfo.new(0.2), {BackgroundColor3 = THEME.ROW}):Play()
        end
        setStatus("Loop: " .. (bringAllLoop and "ON" or "OFF"), false)
        -- NOTE: save loop state
        SaveData.bringAllLoop = bringAllLoop
        writeSave()
    end)

    noclipBtn.MouseButton1Click:Connect(toggleNoclip)

    -- SEARCH BAR
    searchBox = Instance.new("TextBox")
    searchBox.Name = "SearchBox"
    searchBox.Size = UDim2.new(1, -20, 0, 26)
    searchBox.Position = UDim2.fromOffset(10, 84)
    searchBox.BackgroundColor3 = THEME.ROW
    searchBox.BorderSizePixel = 0
    searchBox.Font = Enum.Font.Gotham
    searchBox.TextSize = 12
    searchBox.TextColor3 = THEME.TEXT
    searchBox.PlaceholderText = "Rechercher un joueur..."
    searchBox.PlaceholderColor3 = THEME.SUBTEXT
    searchBox.Text = ""
    searchBox.ClearTextOnFocus = false
    searchBox.Parent = mainFrame
    local sbc = Instance.new("UICorner"); sbc.CornerRadius = UDim.new(0, 6); sbc.Parent = searchBox
    
    searchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter)

    -- LIST
    listFrame = Instance.new("ScrollingFrame")
    listFrame.Size = UDim2.new(1, -16, 1, -160)
    listFrame.Position = UDim2.fromOffset(8, 116)
    listFrame.BackgroundTransparency = 1
    listFrame.BorderSizePixel = 0
    listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    listFrame.ScrollBarThickness = 4
    listFrame.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 85)
    listFrame.Parent = mainFrame

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = listFrame

    -- STATUS
    statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, -20, 0, 20)
    statusLabel.Position = UDim2.new(0, 10, 1, -28)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Font = Enum.Font.GothamMedium
    statusLabel.TextSize = 11
    statusLabel.TextColor3 = THEME.SUBTEXT
    statusLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel.Text = "Prêt."
    statusLabel.Parent = mainFrame

    uiScale = Instance.new("UIScale")
    uiScale.Scale = 1
    uiScale.Parent = mainFrame

    -- RESIZE HANDLE
    local resizeHandle = Instance.new("TextButton")
    resizeHandle.Name = "ResizeHandle"
    resizeHandle.Size = UDim2.new(0, 20, 0, 20)
    resizeHandle.Position = UDim2.new(1, -20, 1, -20)
    resizeHandle.BackgroundTransparency = 1
    resizeHandle.Text = "◢"
    resizeHandle.TextColor3 = THEME.SUBTEXT
    resizeHandle.Font = Enum.Font.GothamBold
    resizeHandle.TextSize = 14
    resizeHandle.ZIndex = 10
    resizeHandle.Parent = mainFrame
    
    resizeHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isResizing = true
            resizeStart = input.Position
            startSizeX = mainFrame.Size.X.Offset
            startSizeY = mainFrame.Size.Y.Offset
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if isResizing then
                -- NOTE: save panel size
                SaveData.panelSize = { ox = mainFrame.Size.X.Offset, oy = mainFrame.Size.Y.Offset }
                writeSave()
                isResizing = false
            end
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isResizing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - resizeStart
            local scale = uiScale.Scale or 1
            local newWidth = math.max(CONFIG.MIN_WIDTH, startSizeX + (delta.X / scale))
            local newHeight = math.max(CONFIG.MIN_HEIGHT, startSizeY + (delta.Y / scale))
            mainFrame.Size = UDim2.fromOffset(newWidth, newHeight)
        end
    end)
    resizeHandle.MouseEnter:Connect(function() resizeHandle.TextColor3 = THEME.TEXT end)
    resizeHandle.MouseLeave:Connect(function() resizeHandle.TextColor3 = THEME.SUBTEXT end)

    -- APPLY SAVE DATA
    if SaveData.panelPosition then
        mainFrame.Position = UDim2.new(
            SaveData.panelPosition.sx or 1, SaveData.panelPosition.ox or -20,
            SaveData.panelPosition.sy or 0.5, SaveData.panelPosition.oy or 0
        )
    end
    if SaveData.panelSize then
        mainFrame.Size = UDim2.new(
            0, math.max(CONFIG.MIN_WIDTH, SaveData.panelSize.ox or CONFIG.PANEL_WIDTH),
            0, math.max(CONFIG.MIN_HEIGHT, SaveData.panelSize.oy or CONFIG.PANEL_HEIGHT)
        )
    end
    if SaveData.uiScale then
        uiScale.Scale = SaveData.uiScale
    end
    if SaveData.bringAllLoop then
        bringAllLoop = true
        loopBtn.TextColor3 = THEME.SUCCESS
        loopBtn.BackgroundColor3 = Color3.fromRGB(30, 50, 35)
    end
    if SaveData.noclipEnabled then
        enableNoclip() -- enableNoclip gère déjà la mise à jour visuelle du bouton noclip
    end
end

--============================================================
-- ÉVÉNEMENTS
--============================================================
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then createRow(p) end end)
Players.PlayerRemoving:Connect(function(p) removeRow(p) end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == CONFIG.STOP_KEY then
        if bringAllActive then bringAllActive = false end
        if followTarget then stopFollow("Follow arrêté") end
    elseif input.KeyCode == CONFIG.BRING_ALL_KEY then 
        bringAll() 
        if bringAllBtn then bringAllBtn.TextColor3 = bringAllActive and THEME.ACCENT or THEME.SUBTEXT end
    elseif input.KeyCode == CONFIG.LOOP_KEY then
        if loopBtn then loopBtn.MouseButton1Click:Fire() end
    elseif input.KeyCode == CONFIG.NOCLIP_KEY then
        toggleNoclip()
    end
end)

UserInputService.InputChanged:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseWheel and uiScale then
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
            uiScale.Scale = math.clamp(uiScale.Scale + input.Position.Z * CONFIG.UI_SCALE_STEP, CONFIG.UI_SCALE_MIN, CONFIG.UI_SCALE_MAX)
            -- NOTE: save ui scale
            SaveData.uiScale = uiScale.Scale
            writeSave()
        end
    end
end)

