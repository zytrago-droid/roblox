-- BOOT
--============================================================
buildUI()
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createRow(p) end
end
if LocalPlayer.Character then
    local nchar = LocalPlayer.Character
    task.spawn(function() task.wait(0.1); if noclipEnabled then scanCharacter(nchar); enforceNoclip() end end)
end
print("[Bring] Modern UI Loaded. B=panel | G=all | L=loop | K=noclip | N=stop")
