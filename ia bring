local function createHoverEffect(btn, normalColor, hoverColor)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = hoverColor}):Play()
    end)
    btn.MouseLeave:Connect(function()
        if btn.BackgroundColor3 == hoverColor then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = normalColor}):Play()
        end
    end)
end

updateRowState = function(player, following)
    local row = playerRows[player]
    if not row or not row.Parent then return end
    local btn = row:FindFirstChild("ActionBtn")
    if following then
        TweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = THEME.ROW_ACTIVE}):Play()
        if btn then 
            btn.Text = "Stop"
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = THEME.DANGER}):Play()
        end
    else
        TweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = THEME.ROW}):Play()
        if btn then 
            btn.Text = "Bring"
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = THEME.ACCENT}):Play()
        end
    end
end

local function onRowClick(player, row)
    if bringAllActive then bringAllActive = false end
    if followTarget == player then stopFollow("Follow arrêté"); return end
    if startFollow(player) then
        -- Flash effect
        row.BackgroundColor3 = THEME.ACCENT
        task.delay(0.15, function()
            if row and row.Parent then updateRowState(player, true) end
        end)
    end
end

