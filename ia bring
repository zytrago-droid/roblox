--============================================================
-- BRING ALL
--============================================================
local function bringAll()
    if bringAllActive then bringAllActive = false; return end
    if followTarget then stopFollow(nil) end
    disableLocalAntiCheat()

    local function getValidTargets()
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and getTargetHRP(p) then table.insert(list, p) end
        end
        return list
    end

    local targets = getValidTargets()
    if #targets == 0 then setStatus("Aucun joueur valide", true); return end

    bringAllActive = true
    setStatus("Bring All en cours...", false)

    bringAllThread = task.spawn(function()
        repeat
            for _, p in ipairs(targets) do
                if not bringAllActive then break end
                if getTargetHRP(p) then
                    strictTeleportBehind(p)
                    setStatus("Bring: " .. p.DisplayName, false)
                    local startWait = os.clock()
                    while os.clock() - startWait < CONFIG.BRING_ALL_WAIT do
                        if not bringAllActive then break end
                        if not getTargetHRP(p) then break end
                        strictTeleportBehind(p)
                        task.wait(0.05)
                    end
                end
            end
            if bringAllLoop and bringAllActive then
                targets = getValidTargets()
                task.wait(0.5)
            end
        until not bringAllLoop or not bringAllActive
        
        bringAllActive = false
        setStatus("Bring All terminé", false)
    end)
end

