--============================================================
-- NOCLIP
--============================================================
local noclipEnabled = false
local noclipConnection = nil
local watchdogConnection = nil
local processedParts = setmetatable({}, {__mode = "k"})
local originalCanCollide = setmetatable({}, {__mode = "k"})
local disabledAntiCheatScripts = setmetatable({}, {__mode = "k"})
local partConnections = {}

local function lockPart(part)
    if not part:IsA("BasePart") then return end
    if processedParts[part] then return end
    processedParts[part] = true
    originalCanCollide[part] = part.CanCollide
    part.CanCollide = false
    if not partConnections[part] then
        partConnections[part] = part:GetPropertyChangedSignal("CanCollide"):Connect(function()
            if noclipEnabled and part.CanCollide then part.CanCollide = false end
        end)
    end
end

local function scanCharacter(char)
    if not char then return end
    for _, descendant in ipairs(char:GetDescendants()) do lockPart(descendant) end
    char.DescendantAdded:Connect(function(descendant)
        if noclipEnabled then lockPart(descendant) end
    end)
end

local function enforceNoclip()
    if not noclipEnabled then return end
    local char = LocalPlayer.Character
    if not char or not char.Parent then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
    end
end

local function enableNoclip()
    if noclipEnabled then return end
    noclipEnabled = true
    local char = LocalPlayer.Character
    if char and char.Parent then
        scanCharacter(char)
        enforceNoclip()
    end
    noclipConnection = RunService.Stepped:Connect(enforceNoclip)
    watchdogConnection = task.spawn(function()
        while noclipEnabled do
            task.wait(0.25)
            if noclipEnabled then
                local currentChar = LocalPlayer.Character
                if currentChar and currentChar.Parent then
                    scanCharacter(currentChar)
                    enforceNoclip()
                end
            end
        end
    end)
    if noclipBtn then
        noclipBtn.TextColor3 = THEME.SUCCESS
        TweenService:Create(noclipBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 50, 35)}):Play()
    end
end

local function disableNoclip()
    if not noclipEnabled then return end
    noclipEnabled = false
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    if watchdogConnection then task.cancel(watchdogConnection); watchdogConnection = nil end
    for part, conn in pairs(partConnections) do pcall(function() conn:Disconnect() end) end
    partConnections = {}
    local char = LocalPlayer.Character
    if char and char.Parent then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                local original = originalCanCollide[part]
                if original ~= nil then part.CanCollide = original
                elseif part.Name == "HumanoidRootPart" then part.CanCollide = false
                else part.CanCollide = true end
            end
        end
    end
    processedParts = setmetatable({}, {__mode = "k"})
    originalCanCollide = setmetatable({}, {__mode = "k"})
    if noclipBtn then
        noclipBtn.TextColor3 = THEME.SUBTEXT
        TweenService:Create(noclipBtn, TweenInfo.new(0.2), {BackgroundColor3 = THEME.ROW}):Play()
    end
end

local function toggleNoclip()
    if noclipEnabled then disableNoclip() else enableNoclip() end
end

LocalPlayer.CharacterAdded:Connect(function(newChar)
    processedParts = setmetatable({}, {__mode = "k"})
    originalCanCollide = setmetatable({}, {__mode = "k"})
    disabledAntiCheatScripts = setmetatable({}, {__mode = "k"})
    if noclipEnabled then
        task.wait(0.1)
        scanCharacter(newChar)
        enforceNoclip()
    end
end)

--============================================================
-- HELPERS
--============================================================
local function setStatus(text, isError)
    if not statusLabel then return end
    statusLabel.Text = text
    statusLabel.TextColor3 = isError and THEME.DANGER or THEME.SUBTEXT
end

local function getThumbnailUrl(userId)
    if thumbnailCache[userId] then return thumbnailCache[userId] end
    local ok, url = pcall(function()
        return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
    end)
    if not ok or type(url) ~= "string" or url == "" then
        url = string.format(CONFIG.FALLBACK_THUMB, userId)
    end
    thumbnailCache[userId] = url
    return url
end

local function disableLocalAntiCheat()
    if not CONFIG.DISABLE_LOCAL_ANTICHEAT then return end
    local char = LocalPlayer.Character
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("LocalScript") and not v.Disabled and not disabledAntiCheatScripts[v] then
            pcall(function() v.Disabled = true end)
            disabledAntiCheatScripts[v] = true
        end
    end
end

local function getTargetHRP(targetPlayer)
    local c = targetPlayer.Character
    if not c or c.Parent ~= workspace then return nil, "Cible introuvable" end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or (hum and hum.Health <= 0) then return nil, "Cible morte" end
    return hrp
end

local function getMyHRP()
    local c = LocalPlayer.Character
    if not c or c.Parent ~= workspace then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return nil end
    return hrp
end

local function strictTeleportBehind(targetPlayer)
    local tHRP, err = getTargetHRP(targetPlayer)
    if not tHRP then return false, err end
    local myChar = LocalPlayer.Character
    if not myChar then return false, "Perso absent" end
    local myHRP = getMyHRP()
    if not myHRP then return false, "Perso mort" end

    disableLocalAntiCheat()
    local behindCF = tHRP.CFrame * CFrame.new(0, CONFIG.Y_OFFSET, CONFIG.BEHIND_OFFSET)

    local ok = pcall(function()
        if myChar.PivotTo then
            myChar:PivotTo(behindCF)
        elseif myChar.PrimaryPart then
            myChar:SetPrimaryPartCFrame(behindCF)
        else
            myHRP.CFrame = behindCF
        end
    end)

    if CONFIG.ZERO_VELOCITY then
        pcall(function() myHRP.AssemblyLinearVelocity = Vector3.zero end)
    end
    return ok
end

--============================================================
-- FOLLOW
--============================================================
local updateRowState

local function stopFollow(reason)
    if not followTarget then return end
    local prev = followTarget
    followTarget = nil
    updateRowState(prev, false)
    if reason then setStatus(reason, true) end
end

local function startFollow(targetPlayer)
    local ok, err = strictTeleportBehind(targetPlayer)
    if not ok then
        setStatus("Échec: " .. (err or "Inconnu"), true)
        return false
    end
    if followTarget and followTarget ~= targetPlayer then
        updateRowState(followTarget, false)
    end
    followTarget = targetPlayer
    lastFollowTick = 0
    updateRowState(targetPlayer, true)
    setStatus("Follow: " .. targetPlayer.DisplayName, false)
    return true
end

RunService.Heartbeat:Connect(function()
    if not followTarget then return end
    local now = os.clock()
    if now - lastFollowTick < (1 / CONFIG.FOLLOW_HZ) then return end
    lastFollowTick = now
    if not followTarget.Parent then stopFollow("Cible déconnectée"); return end
    local ok, err = strictTeleportBehind(followTarget)
    if not ok then stopFollow("Follow: " .. (err or "Perdu")) end
end)

