local function installNoclipHook()
    if noclipHookInstalled or not CAPS.hookmetamethod or not CAPS.checkcaller then return false end
    local ok1 = pcall(function()
        local OldIndex
        OldIndex = hookmetamethod(game, "__index", function(self, key)
            if key=="CanCollide" and not checkcaller() and canCollideCache[self]~=nil then return canCollideCache[self] end
            return OldIndex(self, key)
        end)
    end)
    local ok2 = pcall(function()
        local OldNewIndex
        OldNewIndex = hookmetamethod(game, "__newindex", function(self, key, val)
            if key=="CanCollide" and not checkcaller() and canCollideCache[self]~=nil then return end
            return OldNewIndex(self, key, val)
        end)
    end)
    noclipHookInstalled = ok1 or ok2
    return ok1 and ok2
end

local function lockPart(part)
    if not part:IsA("BasePart") or processedParts[part] then return end
    processedParts[part]=true
    originalCanCollide[part]=part.CanCollide
    canCollideCache[part]=part.CanCollide
    part.CanCollide=false
    if not partConnections[part] then
        partConnections[part]=part:GetPropertyChangedSignal("CanCollide"):Connect(function()
            if noclipEnabled and part.CanCollide then part.CanCollide=false end
        end)
    end
end

local function scanCharacter(ch) if not ch then return end for _,d in ipairs(ch:GetDescendants()) do lockPart(d) end end
local function enforceNoclip()
    if not noclipEnabled then return end
    local c=LocalPlayer.Character if not c or not c.Parent then return end
    for _,p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") and p.CanCollide then p.CanCollide=false end end
end

local function enableNoclip()
    if noclipEnabled then return end
    noclipEnabled=true
    scanCharacter(LocalPlayer.Character)
    installNoclipHook()
    enforceNoclip()
    noclipConnection=RunService.Stepped:Connect(enforceNoclip)
    if noclipBtn then noclipBtn.TextColor3=THEME.SUCCESS; TweenService:Create(noclipBtn,TweenInfo.new(.2),{BackgroundColor3=Color3.fromRGB(30,50,35)}):Play() end
    setStatus(noclipHookInstalled and "noclip: hook active" or "noclip: stepped fallback", false)
end

local function disableNoclip()
    if not noclipEnabled then return end
    noclipEnabled=false
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection=nil end
    for _,c in pairs(partConnections) do pcall(function() c:Disconnect() end) end
    partConnections={}
    local ch=LocalPlayer.Character
    if ch then for _,p in ipairs(ch:GetDescendants()) do if p:IsA("BasePart") then local o=originalCanCollide[p] p.CanCollide=(o~=nil) and o or (p.Name~="HumanoidRootPart") end end end
    processedParts=setmetatable({},{__mode="k"}); originalCanCollide=setmetatable({},{__mode="k"}); canCollideCache={}
    if noclipBtn then noclipBtn.TextColor3=THEME.SUBTEXT; TweenService:Create(noclipBtn,TweenInfo.new(.2),{BackgroundColor3=THEME.ROW}):Play() end
end

local function toggleNoclip() if noclipEnabled then disableNoclip() else enableNoclip() end SaveData.noclipEnabled=noclipEnabled writeSave() end

