local keybindConn=UserInputService.InputBegan:Connect(function(i,gp) if gp then return end local k=i.KeyCode
    if k==CONFIG.STOP_KEY then stopAll()
    elseif k==CONFIG.ACTION_ALL_KEY then actionAll()
    elseif k==CONFIG.LOOP_KEY then actionAllLoop=not actionAllLoop if loopBtn then loopBtn.TextColor3=actionAllLoop and THEME.SUCCESS or THEME.SUBTEXT end
    elseif k==CONFIG.NOCLIP_KEY then toggleNoclip() end
end)

local scaleConn=UserInputService.InputChanged:Connect(function(i,gp)
    if gp or i.UserInputType~=Enum.UserInputType.MouseWheel then return end
    if not UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then return end
    if not (uiScale and uiScale:IsA("UIScale")) then return end
    local d=i.Position.Z>0 and 1 or -1 uiScale.Scale=math.clamp(uiScale.Scale+d*CONFIG.UI_SCALE_STEP,CONFIG.UI_SCALE_MIN,CONFIG.UI_SCALE_MAX)
end)

local playerRemovingConn=Players.PlayerRemoving:Connect(function(p) if followTarget==p then stopFollow("target left") end local r=playerRows[p] if r then pcall(function() r:Destroy() end) playerRows[p]=nil end end)

if getgenv then
    getgenv().__VISIT_V3_CLEANUP=function()
        stopVisualPull()
        pcall(stopAll)
        if heartbeatConnection then heartbeatConnection:Disconnect() heartbeatConnection=nil end
        if charAddedConnection then charAddedConnection:Disconnect() charAddedConnection=nil end
        if playerRemovingConn then playerRemovingConn:Disconnect() playerRemovingConn=nil end
        if keybindConn then keybindConn:Disconnect() keybindConn=nil end
        if scaleConn then scaleConn:Disconnect() scaleConn=nil end
        if noclipConnection then noclipConnection:Disconnect() noclipConnection=nil end
        for _,c in pairs(partConnections) do pcall(function() c:Disconnect() end) end partConnections={}
        if panelGui then pcall(function() panelGui:Destroy() end) panelGui=nil end
        if getgenv().__VISIT_V3_LOADED then getgenv().__VISIT_V3_LOADED=nil end
    end
    getgenv().__VISIT_V3_LOADED=true
end

buildUI()
Players.PlayerAdded:Connect(function(p) if p~=LocalPlayer then createRow(p) end end)
print("[visit v3] loaded — caps: hook="..tostring(CAPS.hookmetamethod).." ownership="..tostring(CAPS.setnetworkowner).." | N=stop G=all L=loop K=noclip")
