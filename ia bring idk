--============ BRING MODES v3.1 ============
local visualLoopConn = nil
local visualTarget = nil

local function stopVisualPull()
    if visualLoopConn then
        visualLoopConn:Disconnect()
        visualLoopConn = nil
    end
    visualTarget = nil
end

local function startVisualPull(targetPlayer)
    stopVisualPull()
    visualTarget = targetPlayer
    visualLoopConn = RunService.RenderStepped:Connect(function()
        local t = visualTarget
        if not t or not t.Parent then stopVisualPull() return end
        local tHRP = getTargetHRP(t)
        local myHRP = getMyHRP()
        if not tHRP or not myHRP then return end
        local dest = myHRP.CFrame * CFrame.new(0, 0, -4)
        pcall(function() tHRP.CFrame = dest end)
    end)
    return true
end

local function bringVisual(targetPlayer)
    local tHRP, err = getTargetHRP(targetPlayer)
    if not tHRP then return false, err end
    local myHRP = getMyHRP()
    if not myHRP then return false, "self dead" end
    local dist = (tHRP.Position - myHRP.Position).Magnitude
    if dist > CONFIG.MAX_BRING_DIST then return false, "too far" end
    startVisualPull(targetPlayer)
    return true, "visual-pull-active"
end

local function bringNetwork(targetPlayer)
    local tHRP, err = getTargetHRP(targetPlayer)
    if not tHRP then return false, err end

    local owner = nil
    pcall(function() owner = tHRP:GetNetworkOwner() end)

    if owner == LocalPlayer then
        local myHRP = getMyHRP()
        if myHRP then
            local dest = myHRP.CFrame * CFrame.new(0, 0, -4)
            pcall(function() tHRP.CFrame = dest end)
            return true, "owned-direct"
        end
    end

    local ok = pcall(function() tHRP:SetNetworkOwner(LocalPlayer) end)
    if ok then
        local owner2 = nil
        pcall(function() owner2 = tHRP:GetNetworkOwner() end)
        if owner2 == LocalPlayer then
            local myHRP = getMyHRP()
            if myHRP then
                local dest = myHRP.CFrame * CFrame.new(0, 0, -4)
                pcall(function() tHRP.CFrame = dest end)
            end
            return true, "owned-acquired"
        end
    end

    startVisualPull(targetPlayer)
    return true, "fallback-visual"
end

local function visitBehind(targetPlayer)
    local tHRP,err=getTargetHRP(targetPlayer) if not tHRP then return false,err end
    local myHRP=getMyHRP() if not myHRP then return false,"self dead" end
    local t=now() if t-lastTeleport<CONFIG.TELEPORT_COOLDOWN then return false,"cooldown" end
    local myChar=LocalPlayer.Character if not myChar then return false,"self gone" end
    local dest=tHRP.CFrame*CFrame.new(0,CONFIG.Y_OFFSET,CONFIG.BEHIND_OFFSET)
    local ok=pcall(function() if myChar.PivotTo then myChar:PivotTo(dest) else myHRP.CFrame=dest end end)
    if ok then lastTeleport=t pcall(function() myHRP.AssemblyLinearVelocity=Vector3.zero end) end
    return ok
end

local function applyBring(targetPlayer)
    local mode=CONFIG.BRING_MODE
    if mode=="NETWORK" then local ok,err=bringNetwork(targetPlayer) if ok then return true end if err~="no ownership api" and err~="ownership denied" then return false,err end end
    if mode=="VISUAL" or mode=="NETWORK" then local ok,err=bringVisual(targetPlayer) if ok then return true end if mode=="VISUAL" then return false,err end end
    return visitBehind(targetPlayer)
end

local function updateRowState(p,f)
