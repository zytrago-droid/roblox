end

local function stopFollow(reason) stopVisualPull() if not followTarget then return end local p=followTarget followTarget=nil updateRowState(p,false) if reason then setStatus(reason,true) end end
local function startFollow(p) local ok,err=applyBring(p) if not ok and err~="cooldown" then setStatus("fail: "..(err or "?"),true) return false end if followTarget and followTarget~=p then updateRowState(followTarget,false) end followTarget=p lastFollowTick=0 updateRowState(p,true) setStatus("follow ["..CONFIG.BRING_MODE.."]: "..p.DisplayName,false) return true end

local FOLLOW_INTERVAL=math.max(1/CONFIG.FOLLOW_HZ,CONFIG.TELEPORT_COOLDOWN)
heartbeatConnection=RunService.Heartbeat:Connect(function()
    if not followTarget then return end
    local t=now() if t-lastFollowTick<FOLLOW_INTERVAL then return end lastFollowTick=t
    if not followTarget.Parent then stopFollow("target left") return end
    local ok,err=applyBring(followTarget) if not ok and err~="cooldown" then stopFollow("follow: "..(err or "lost")) end
end)

local function cancelActionAll() if actionAllThread then pcall(function() task.cancel(actionAllThread) end) actionAllThread=nil end actionAllActive=false end

local function actionAll()
    if actionAllActive then cancelActionAll() setStatus("action all stopped",false) return end
    if followTarget then stopFollow(nil) end
    local function valid() local l={} for _,p in ipairs(Players:GetPlayers()) do if p~=LocalPlayer and getTargetHRP(p) then table.insert(l,p) end end return l end
    local targets=valid() if #targets==0 then setStatus("no valid targets",true) return end
    actionAllActive=true setStatus("action all ["..CONFIG.BRING_MODE.."] running",false)
    actionAllThread=task.spawn(function()
        while actionAllActive do
            for _,p in ipairs(targets) do
                if not actionAllActive then break end
                if getTargetHRP(p) then
                    local deadline=now()+CONFIG.ACTION_ALL_WAIT
                    while now()<deadline and actionAllActive do applyBring(p) setStatus("action: "..p.DisplayName,false) task.wait(CONFIG.TELEPORT_COOLDOWN) end
                end
            end
            if actionAllLoop and actionAllActive then targets=valid() task.wait(0.5) else break end
        end
        actionAllActive=false actionAllThread=nil setStatus("action all done",false)
    end)
end

