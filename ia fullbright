local function updateUI()
    if ENABLED then
        toggleBtn.Text = "Disable Full Bright"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 110, 70)
        status.Text = "ON"
        status.TextColor3 = Color3.fromRGB(100, 220, 140)
    else
        toggleBtn.Text = "Enable Full Bright"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 63, 68)
        status.Text = "OFF"
        status.TextColor3 = Color3.fromRGB(160, 160, 160)
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    setFullBright(not ENABLED)
    updateUI()
end)

closeBtn.MouseButton1Click:Connect(function()
    if ENABLED then
        setFullBright(false)
    end
    _G.FullBrightLoaded = false
    screenGui:Destroy()
end)

-- ============================================================
-- KEYBIND
-- ============================================================
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == CONFIG.TOGGLE_KEY then
        setFullBright(not ENABLED)
        updateUI()
    end
end)

-- ============================================================
-- BOOT
-- ============================================================
updateUI()
notify("Full Bright", "Loaded. RightControl = toggle", 3)
print("[FullBright] Loaded. RightControl = toggle.")
