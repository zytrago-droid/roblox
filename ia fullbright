--[[
    Universal Full Bright — Xeno compatible
    Toggle: RightControl  |  GUI button
    
    Ce script modifie les propriétés du service Lighting pour supprimer l'ombre
    et la noirceur. Il inclut un watchdog qui réapplique les valeurs si le jeu
    tente de les réinitialiser.
    
    Sources:
    - ScriptBlox "Universal Script | FullBright" : Ambient = 255, OutdoorAmbient = 255, Brightness = 2.
    - Pastebin "Universal FullBright (Super Safe x100)" : Brightness = 1.2, Ambient = 185,
      OutdoorAmbient = 175, FogStart = 0, FogEnd = 9999999, Technology = Compatibility.
    - Roblox Creator Hub : Ambient contrôle la lumière dans les zones ombragées,
      ClockTime contrôle l'heure du jour, Brightness contrôle l'intensité globale.
    
    Limite honnête : si le jeu utilise un script serveur qui force le retour du
    lighting original (anti-cheat ou cycle jour/nuit), le watchdog réappliquera
    les valeurs côté client, mais le serveur peut les écraser à chaque frame.
    Le full bright reste une modification locale.
]]

if _G.FullBrightLoaded then return end
_G.FullBrightLoaded = true

local Lighting      = game:GetService("Lighting")
local RunService    = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService  = game:GetService("TweenService")
local StarterGui    = game:GetService("StarterGui")

-- ============================================================
-- CONFIG
-- ============================================================
local CONFIG = {
    TOGGLE_KEY       = Enum.KeyCode.RightControl,
    -- Valeurs cibles (inspirées de ScriptBlox et Pastebin)
    TARGET_BRIGHTNESS       = 2,           -- ScriptBlox utilise 2, Pastebin 1.2. On prend 2 pour un effet franc.
    TARGET_AMBIENT          = Color3.fromRGB(255, 255, 255),
    TARGET_OUTDOOR_AMBIENT  = Color3.fromRGB(255, 255, 255),
    TARGET_FOG_START        = 0,
    TARGET_FOG_END          = 9999999,
    TARGET_CLOCK_TIME       = 14,          -- midi, évite que le cycle jour/nuit assombrisse
    TARGET_SHADOW_SOFTNESS  = 0,
    TARGET_GLOBAL_SHADOWS   = false,
    TARGET_ENVIRONMENT_DIFFUSE = 0,        -- réduit la lumière ambiante du ciel
    TARGET_ENVIRONMENT_SPECULAR = 0,
    WATCHDOG_INTERVAL       = 2,           -- secondes entre chaque réapplication
}

-- ============================================================
-- STATE
-- ============================================================
local ENABLED       = false
local WATCHDOG_ALIVE = true
local original      = {}
local watchdogConn  = nil
local changedConn   = nil

-- ============================================================
-- HELPERS
-- ============================================================
local function notify(title, text, dur)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title, Text = text, Duration = dur or 3,
        })
    end)
end

local function saveOriginal()
    original = {
        Brightness = Lighting.Brightness,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        FogStart = Lighting.FogStart,
        FogEnd = Lighting.FogEnd,
        ClockTime = Lighting.ClockTime,
        ShadowSoftness = Lighting.ShadowSoftness,
        GlobalShadows = Lighting.GlobalShadows,
        EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
        EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
    }
end

local function applyFullBright()
    if not ENABLED then return end
    pcall(function()
        Lighting.Brightness = CONFIG.TARGET_BRIGHTNESS
        Lighting.Ambient = CONFIG.TARGET_AMBIENT
        Lighting.OutdoorAmbient = CONFIG.TARGET_OUTDOOR_AMBIENT
        Lighting.FogStart = CONFIG.TARGET_FOG_START
        Lighting.FogEnd = CONFIG.TARGET_FOG_END
        Lighting.ClockTime = CONFIG.TARGET_CLOCK_TIME
        Lighting.ShadowSoftness = CONFIG.TARGET_SHADOW_SOFTNESS
        Lighting.GlobalShadows = CONFIG.TARGET_GLOBAL_SHADOWS
        Lighting.EnvironmentDiffuseScale = CONFIG.TARGET_ENVIRONMENT_DIFFUSE
        Lighting.EnvironmentSpecularScale = CONFIG.TARGET_ENVIRONMENT_SPECULAR
    end)
end

local function restoreOriginal()
    pcall(function()
        for k, v in pairs(original) do
            if Lighting[k] ~= nil then
                Lighting[k] = v
            end
        end
    end)
end

-- ============================================================
-- SUPPRESSION DES EFFETS DE POST-TRAITEMENT
-- (ColorCorrection, Blur, etc. peuvent assombrir même avec Ambient à 255)
-- ============================================================
local savedEffects = {}

local function disablePostEffects()
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("ColorCorrectionEffect")
            or effect:IsA("BlurEffect")
            or effect:IsA("SunRaysEffect")
            or effect:IsA("DepthOfFieldEffect")
            or effect:IsA("BloomEffect") then
            if not savedEffects[effect] then
                savedEffects[effect] = {
                    Enabled = effect.Enabled,
                }
            end
            pcall(function() effect.Enabled = false end)
        end
    end
end

local function restorePostEffects()
    for effect, state in pairs(savedEffects) do
        if effect and effect.Parent then
            pcall(function() effect.Enabled = state.Enabled end)
        end
    end
    savedEffects = {}
end

-- ============================================================
-- WATCHDOG (protège contre les resets du jeu)
-- ============================================================
local function startWatchdog()
    if watchdogConn then return end
    watchdogConn = task.spawn(function()
        while WATCHDOG_ALIVE and ENABLED do
            task.wait(CONFIG.WATCHDOG_INTERVAL)
            if ENABLED then
                applyFullBright()
                disablePostEffects()
            end
        end
    end)
end

local function stopWatchdog()
    WATCHDOG_ALIVE = false
    if watchdogConn then
        task.cancel(watchdogConn)
        watchdogConn = nil
    end
end

-- Protection contre les scripts qui modifient Lighting.Changed
local function startChangedProtection()
    if changedConn then return end
    changedConn = Lighting.Changed:Connect(function()
        if ENABLED then
            task.defer(applyFullBright)
            task.defer(disablePostEffects)
        end
    end)
end

local function stopChangedProtection()
    if changedConn then
        changedConn:Disconnect()
        changedConn = nil
    end
end

-- ============================================================
-- TOGGLE
-- ============================================================
local function setFullBright(state)
    ENABLED = state
    if state then
        saveOriginal()
        applyFullBright()
        disablePostEffects()
        WATCHDOG_ALIVE = true
        startWatchdog()
        startChangedProtection()
        notify("Full Bright", "ON", 2)
    else
        stopWatchdog()
        stopChangedProtection()
        restoreOriginal()
        restorePostEffects()
        notify("Full Bright", "OFF", 2)
    end
end

