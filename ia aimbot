        local function applyMouse(mx)
            local ax, aw = trackFrame.AbsolutePosition.X, trackFrame.AbsoluteSize.X
            if aw <= 0 then return end
            apply((mx - ax) / aw)
        end
        track(trackFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                applyMouse(input.Position.X)
            end
        end))
