            if on == lastOn and disabled == lastDisabled then return end
            lastOn = on
            lastDisabled = disabled
            local targetColor = on and Colors.Accent or Colors.Surface2
            local targetKnob  = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 186, 194)
            local targetPos   = on and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
            if animate then
                TweenService:Create(sw, info, { BackgroundColor3 = targetColor }):Play()
                TweenService:Create(knob, info, { BackgroundColor3 = targetKnob, Position = targetPos }):Play()
            else
                sw.BackgroundColor3 = targetColor
                knob.BackgroundColor3 = targetKnob
                knob.Position = targetPos
            end
            if disabled then
                lbl.TextTransparency = 0.55
                sw.BackgroundTransparency = 0.55
                knob.BackgroundTransparency = 0.4
            else
                lbl.TextTransparency = 0
                sw.BackgroundTransparency = 0
                knob.BackgroundTransparency = 0
            end
        end
        render(false)
        addRefresher(function() render(true) end)

        track(row.MouseEnter:Connect(function()
            if disabledBy and disabledBy() then return end
            TweenService:Create(row, info, { BackgroundTransparency = 0 }):Play()
        end))
        track(row.MouseLeave:Connect(function()
            TweenService:Create(row, info, { BackgroundTransparency = 1 }):Play()
        end))
        track(row.MouseButton1Click:Connect(function()
            if disabledBy and disabledBy() then return end
            Config[key] = not Config[key]
            render(true)
            saveSoon()
            if onChange then pcall(onChange) end
        end))
    end

