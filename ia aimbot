-- ============================================================
-- INPUT
-- ============================================================
track(UserInputService.InputBegan:Connect(function(input, gp)
    if closed then return end

    local rawIdx = extractMouseIndex(input.UserInputType)
    if rawIdx and mouseHeld[rawIdx] ~= nil then
        mouseHeld[rawIdx] = true
        if rawIdx >= 4 and not m45Seen[rawIdx] then
            m45Seen[rawIdx] = true
            print("[Aimbot] M" .. rawIdx .. " détecté et bindable.")
        end
    end

    if rebinding then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.Escape then
                rebinding = nil
            elseif input.KeyCode ~= Enum.KeyCode.Unknown and not reservedKeys[input.KeyCode] then
                Config[rebinding] = keyBind(input.KeyCode)
                rebinding = nil
                saveSoon()
            end
            return
        end
        if rawIdx and rawIdx >= 1 then
            Config[rebinding] = mouseBind(rawIdx)
            rebinding = nil
            saveSoon()
            return
        end
        return
    end

    if gp then return end

    local function matches(bind, inp)
        if bind.kind == "key" then
            return inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode == bind.code
        else
            return extractMouseIndex(inp.UserInputType) == bind.index
        end
    end

    if matches(Config.AimbotBind, input) then
        if not Config.HoldToAim then
            Config.Enabled = not Config.Enabled
        end
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if closed then return end
    local rawIdx = extractMouseIndex(input.UserInputType)
    if rawIdx and mouseHeld[rawIdx] ~= nil then
        mouseHeld[rawIdx] = false
    end
end))

