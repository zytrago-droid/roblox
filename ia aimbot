-- =====================================================================
-- CANDIDATE CACHE
-- =====================================================================
candidates = {}
candidateSet = {}
candidateTeam = {}
candidateOwner = {}
partCache = {}
hrpJitters = {}
local candidateDirty = true

local function scanSubtree(root)
    local list = root:GetDescendants()
    for i = 1, #list do
        local obj = list[i]
        if obj:IsA("Model") and not candidateSet[obj] then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                candidates[#candidates + 1] = obj
                candidateSet[obj] = true
                candidateTeam[obj] = false
                candidateOwner[obj] = nil
            end
        end
    end
end

local function removeFromCandidates(model)
    if candidateSet[model] then
        candidateSet[model] = nil
        candidateTeam[model] = nil
        candidateOwner[model] = nil
        partCache[model] = nil
        for i = #candidates, 1, -1 do
            if candidates[i] == model then
                table_remove(candidates, i)
                break
            end
        end
    end
end

local function rebuildCandidates()
    table_clear(candidateSet)
    table_clear(candidateTeam)
    table_clear(candidateOwner)
    table_clear(partCache)
    candidates = {}

    if Config.TargetNPCs then pcall(scanSubtree, workspace) end
    if Config.TargetPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local char = plr.Character
                if char and not candidateSet[char] then
                    candidates[#candidates + 1] = char
                    candidateSet[char] = true
                    candidateTeam[char] = plr.Team or false
                    candidateOwner[char] = plr
                end
            end
        end
    end
    candidateDirty = false
end

local function markDirty() candidateDirty = true end

-- =====================================================================
-- TARGET HELPERS
-- =====================================================================
local PART_CACHE_TTL = 0.25

local function resolvePart(character)
    local now = os_clock()
    local c = partCache[character]
    if c and now - c.t < PART_CACHE_TTL and c.part and c.part.Parent then
        return c.part
    end
    local p = character:FindFirstChild(Config.TargetPart)
    if not p and (Config.TargetPart == "UpperTorso" or Config.TargetPart == "Torso") then
        p = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    end
    if not p then
        p = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
    end
    partCache[character] = { part = p, t = now }
    return p
end

local function toScreen(worldPos)
    local cam = cachedCamera
    if not cam then return nil, false end
    local sp, onScreen = cam:WorldToViewportPoint(worldPos)
    return sp, onScreen
end

local rayParams = RaycastParams.new()
local rayFilterList = { LocalPlayer.Character }
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.FilterDescendantsInstances = rayFilterList

local function refreshLocalCharFilter()
    local c = LocalPlayer.Character
    if rayFilterList[1] ~= c then
        rayFilterList[1] = c
        rayParams.FilterDescendantsInstances = rayFilterList
    end
end
refreshLocalCharFilter()
track(LocalPlayer.CharacterAdded:Connect(refreshLocalCharFilter))

local function hasLineOfSight(part, worldPos)
    local cam = cachedCamera
    if not cam then return true end
    local origin = cam.CFrame.Position
    local dir = worldPos - origin
    local res = workspace:Raycast(origin, dir, rayParams)
    if not res then return true end
    return res.Instance and res.Instance:IsDescendantOf(part.Parent)
end

local function getHRPJitter(part)
    local now = os_clock()
    local c = hrpJitters[part]
    if not c or now - c.lastT >= Config.HRPJitterInterval then
        local r = Config.HRPJitterRadius
        c = {
            lastT = now,
            offset = Vector3_new(
                (math_random() * 2 - 1) * r,
                (math_random() * 2 - 1) * r * 0.5,
                (math_random() * 2 - 1) * r),
        }
        hrpJitters[part] = c
    end
    return c.offset
end

local MAX_STUDS_SQ = 2000 * 2000

-- =====================================================================
-- FIND TARGET
-- =====================================================================
local function findTarget()
    local cam = cachedCamera or workspace.CurrentCamera
    if not cam then return nil end

    local mouse = UserInputService:GetMouseLocation()
    local refX, refY
    if Config.TargetMode == "Center" then
        refX = cam.ViewportSize.X * 0.5
        refY = cam.ViewportSize.Y * 0.5
    else
        refX = mouse.X
        refY = mouse.Y
    end
    local camPos = cam.CFrame.Position
    local fovSq = Config.FOVRadius * Config.FOVRadius

    local bestVisible, bestVisibleD = nil, math.huge
    local bestAny, bestAnyD = nil, math.huge

    local myTeam = LocalPlayer.Team
    local teamCount = 0
    local teamSeen = {}
    do
        local all = Players:GetPlayers()
        for i = 1, #all do
            local p = all[i]
            if p ~= LocalPlayer then
                local k = teamKeyOf(p)
                if not teamSeen[k] then
                    teamSeen[k] = true
                    teamCount = teamCount + 1
                end
            end
        end
    end
    local applyTeamFilter = teamFilterActive and teamCount >= 2

    for i = #candidates, 1, -1 do
        local model = candidates[i]
        if not model.Parent then
            removeFromCandidates(model)
        else
            local skip = false
            local modelHum = model:FindFirstChildOfClass("Humanoid")
            if modelHum and modelHum.Health <= 0 then skip = true end

            if not skip and Config.TeamCheck then
                local t = candidateTeam[model]
                if t and t == myTeam then skip = true end
            end

            if not skip then
                local owner = candidateOwner[model]
                if applyTeamFilter and owner then
                    local tt = candidateTeam[model]
                    local key = tt and tt.Name or "__none"
                    if not SelectedTeams[key] then skip = true end
                end
                if not Config.TargetPlayers and owner then
                    skip = true
                elseif not Config.TargetNPCs and not owner then
                    skip = true
                end
                if not skip then
                    if owner then
                        local state = PlayerPrefs[tostring(owner.UserId)]
                        if state == "friend" then
                            skip = true
                        elseif Config.EnemyOnly and state ~= "enemy" then
                            skip = true
                        end
                    else
                        if Config.EnemyOnly then skip = true end
                    end
                end
            end

            if not skip then
                local part = resolvePart(model)
                if part then
                    local actualPos = part.Position
                    local aimPos = actualPos
                    if Config.UsePrediction then
                        aimPos = aimPos + part.AssemblyLinearVelocity * Config.Prediction
                    end
                    if part.Name == "HumanoidRootPart" then
                        aimPos = aimPos + getHRPJitter(part)
                    end
                    local d3 = aimPos - camPos
                    if d3:Dot(d3) < MAX_STUDS_SQ then
                        local sp, onScreen = toScreen(aimPos)
                        if sp and onScreen then
                            local dx = sp.X - refX
                            local dy = sp.Y - refY
                            local dSq = dx * dx + dy * dy
                            if dSq < fovSq then
                                local los = hasLineOfSight(part, actualPos)
                                if dSq < bestAnyD then
                                    bestAnyD = dSq
                                    bestAny = { model = model, part = part, worldPos = aimPos, sx = sp.X, sy = sp.Y }
                                end
                                if los and dSq < bestVisibleD then
                                    bestVisibleD = dSq
                                    bestVisible = { model = model, part = part, worldPos = aimPos, sx = sp.X, sy = sp.Y }
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if Config.VisibleCheck then return bestVisible end
    return bestVisible or bestAny
end

-- =====================================================================
-- FUZZY MATCH (recherche de joueur dans la GUI)
-- =====================================================================
local function levenshtein(a, b)
    if a == b then return 0 end
    local la, lb = #a, #b
    if la == 0 then return lb end
    if lb == 0 then return la end
    local prev, curr = {}, {}
    for j = 0, lb do prev[j] = j end
    for i = 1, la do
        curr[0] = i
        local ai = a:sub(i, i)
        for j = 1, lb do
            local cost = (ai == b:sub(j, j)) and 0 or 1
            local del = prev[j] + 1
            local ins = curr[j - 1] + 1
            local sub = prev[j - 1] + cost
            local m = del
            if ins < m then m = ins end
            if sub < m then m = sub end
            curr[j] = m
        end
        prev, curr = curr, prev
    end
    return prev[lb]
end

