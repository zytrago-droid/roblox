-- =====================================================================
-- LIFECYCLE + PER-PLAYER CONNECTIONS
-- =====================================================================
local Connections = {}
local closed = false
local guiRef, renderConn, scanConn, guiConn = nil, nil, nil, nil
local function track(c)
    table.insert(Connections, c)
    return c
end

local PlayerConnections = {}
local function trackPlayer(plr, conn)
    if not plr then return conn end
    local uid = plr.UserId
    if not PlayerConnections[uid] then PlayerConnections[uid] = {} end
    table.insert(PlayerConnections[uid], conn)
    return conn
end
local function disconnectPlayer(plr)
    local uid = plr.UserId
    local list = PlayerConnections[uid]
    if not list then return end
    for _, c in ipairs(list) do
        if c.Connected then pcall(function() c:Disconnect() end) end
    end
    PlayerConnections[uid] = nil
end

local fovCircle
local candidates, candidateSet, candidateTeam, candidateOwner, partCache, hrpJitters
local currentTarget

local function cleanup()
    if closed then return end
    pcall(writeSave)
    closed = true

    if renderConn then pcall(function() renderConn:Disconnect() end); renderConn = nil end
    if scanConn then pcall(function() task_cancel(scanConn) end); scanConn = nil end
    if guiConn then pcall(function() task_cancel(guiConn) end); guiConn = nil end

    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    Connections = {}

    for uid, list in pairs(PlayerConnections) do
        for _, c in ipairs(list) do
            if c.Connected then pcall(function() c:Disconnect() end) end
        end
        PlayerConnections[uid] = nil
    end

    Config.Enabled = false
    Config.Held = false
    currentTarget = nil

    if fovCircle then
        pcall(function() fovCircle.Visible = false end)
        pcall(function() fovCircle:Remove() end)
        pcall(function() fovCircle:Destroy() end)
        fovCircle = nil
    end

    if guiRef then pcall(function() guiRef:Destroy() end) end
    guiRef = nil

    if candidates then table_clear(candidates) end
    if candidateSet then table_clear(candidateSet) end
    if candidateTeam then table_clear(candidateTeam) end
    if candidateOwner then table_clear(candidateOwner) end
    if partCache then table_clear(partCache) end
    if hrpJitters then table_clear(hrpJitters) end
    if SelectedTeams then table_clear(SelectedTeams) end

    uninstallRemoteHooks()
    print("[Aimbot] Closed.")
end

