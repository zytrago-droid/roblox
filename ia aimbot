-- Correction : seuls MouseButton1, 2 et 3 sont des UserInputType valides.
local MOUSE_ENUM = {
    [1] = Enum.UserInputType.MouseButton1,
    [2] = Enum.UserInputType.MouseButton2,
    [3] = Enum.UserInputType.MouseButton3,
}

local function keyBind(code) return { kind = "key", code = code } end
local function mouseBind(index) return { kind = "mouse", index = index } end
local function bindLabel(b)
    if b.kind == "key" then return b.code.Name end
    return "M" .. tostring(b.index)
end

local mouseHeld = { [1] = false, [2] = false, [3] = false }

local function extractMouseIndex(ut)
    if not ut then return nil end
    local okName, nm = pcall(function() return ut.Name end)
    if okName and nm then
        local idx = tonumber(nm:match("MouseButton(%d+)"))
        if idx and idx <= 3 then return idx end
    end
    local okVal, val = pcall(function() return ut.Value end)
    if okVal and val and val >= 1 and val <= 3 then return val end
    return nil
end

local function isBindDown(b)
    if b.kind == "key" then
        local ok, down = pcall(function() return UserInputService:IsKeyDown(b.code) end)
        return ok and down
    else
        if mouseHeld[b.index] then return true end
        local enumType = MOUSE_ENUM[b.index]
        if not enumType then return false end
        local ok, down = pcall(function() return UserInputService:IsMouseButtonPressed(enumType) end)
        return ok and down
    end
end

-- =====================================================================
-- UNIVERSAL REMOTE HOOK ENGINE
-- =====================================================================
local RemoteAim = {
    enabled       = false,
    shotRemotes   = {},
    lastFireTime  = 0,
    detectWindow  = 0.35,
    hookInstalled = false,
    originalNamecall = nil,
    originalFireServer = nil,
    originalInvokeServer = nil,
    originalFire = nil,
    originalInvoke = nil,
    dummyRemote = nil,
    dummyUnreliable = nil,
    dummyRemoteFunction = nil,
    dummyBindableEvent = nil,
    dummyBindableFunction = nil,
}

local function isAimValue(v)
    local t = typeof(v)
    if t == "CFrame" or t == "Vector3" then return true end
    if t == "table" then
        for _, sub in pairs(v) do
            local st = typeof(sub)
            if st == "CFrame" or st == "Vector3" then return true end
        end
    end
    return false
end

local function replaceAimValue(args, targetPos)
    local origin = cachedCamera and cachedCamera.CFrame.Position or Vector3_new(0, 0, 0)
    for i = 1, #args do
        local v = args[i]
        local t = typeof(v)
        if t == "CFrame" then
            args[i] = CFrame_new(targetPos) * v.Rotation
            return true
        elseif t == "Vector3" then
            if v.Magnitude < 10 then
                args[i] = (targetPos - origin).Unit
            else
                args[i] = targetPos
            end
            return true
        elseif t == "table" then
            for k, sub in pairs(v) do
                local st = typeof(sub)
                if st == "CFrame" then
                    v[k] = CFrame_new(targetPos) * sub.Rotation
                    return true
                elseif st == "Vector3" then
                    if sub.Magnitude < 10 then
                        v[k] = (targetPos - origin).Unit
                    else
                        v[k] = targetPos
                    end
                    return true
                end
            end
        end
    end
    return false
end

local REMOTE_CLASSES = {
    RemoteEvent           = true,
    UnreliableRemoteEvent = true,
    RemoteFunction        = true,
    BindableEvent         = true,
    BindableFunction      = true,
}

local function isRemoteInstance(inst)
    if not inst or typeof(inst) ~= "Instance" then return false end
    local ok, cls = pcall(function() return inst.ClassName end)
    return ok and cls and REMOTE_CLASSES[cls] == true
end

local FIRING_METHODS = {
    FireServer   = true,
    fireServer   = true,
    InvokeServer = true,
    invokeServer = true,
    Fire         = true,
    Invoke       = true,
}

local function installNamecallHook()
    if not hookmetamethod or not getrawmetatable or not getnamecallmethod then
        return false
    end
    local mt = getrawmetatable(game)
    if not mt or not mt.__namecall then return false end

    local old = mt.__namecall
    RemoteAim.originalNamecall = old
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if not FIRING_METHODS[method] then
            return old(self, ...)
        end
        if not isRemoteInstance(self) then
            return old(self, ...)
        end

        local args = { ... }
        if os_clock() - RemoteAim.lastFireTime < RemoteAim.detectWindow then
            if isAimValue(args[1]) or isAimValue(args[2]) then
                RemoteAim.shotRemotes[self] = true
            end
        end

        if RemoteAim.enabled and RemoteAim.shotRemotes[self] and currentTarget then
            local targetPos = currentTarget.worldPos
            if targetPos then
                replaceAimValue(args, targetPos)
            end
        end

        return old(self, table_unpack(args))
    end)

    setreadonly(mt, true)
    RemoteAim.hookInstalled = true
    return true
end

local function installDirectHooks()
    if not hookfunction then return false end

    pcall(function()
        RemoteAim.dummyRemote = Instance.new("RemoteEvent")
        RemoteAim.originalFireServer = hookfunction(
            RemoteAim.dummyRemote.FireServer,
            newcclosure(function(self, ...)
                local args = { ... }
                if RemoteAim.enabled and RemoteAim.shotRemotes[self] and currentTarget then
                    local targetPos = currentTarget.worldPos
                    if targetPos then
                        replaceAimValue(args, targetPos)
                    end
                end
                return RemoteAim.originalFireServer(self, table_unpack(args))
            end)
        )
    end)

    pcall(function()
        RemoteAim.dummyUnreliable = Instance.new("UnreliableRemoteEvent")
    end)

    pcall(function()
        RemoteAim.dummyRemoteFunction = Instance.new("RemoteFunction")
        RemoteAim.originalInvokeServer = hookfunction(
            RemoteAim.dummyRemoteFunction.InvokeServer,
            newcclosure(function(self, ...)
                local args = { ... }
                if RemoteAim.enabled and RemoteAim.shotRemotes[self] and currentTarget then
                    local targetPos = currentTarget.worldPos
                    if targetPos then
                        replaceAimValue(args, targetPos)
                    end
                end
                return RemoteAim.originalInvokeServer(self, table_unpack(args))
            end)
        )
    end)

    pcall(function()
        RemoteAim.dummyBindableEvent = Instance.new("BindableEvent")
        RemoteAim.originalFire = hookfunction(
            RemoteAim.dummyBindableEvent.Fire,
            newcclosure(function(self, ...)
                local args = { ... }
                if RemoteAim.enabled and RemoteAim.shotRemotes[self] and currentTarget then
                    local targetPos = currentTarget.worldPos
                    if targetPos then
                        replaceAimValue(args, targetPos)
                    end
                end
                return RemoteAim.originalFire(self, table_unpack(args))
            end)
        )
    end)

    pcall(function()
        RemoteAim.dummyBindableFunction = Instance.new("BindableFunction")
        RemoteAim.originalInvoke = hookfunction(
            RemoteAim.dummyBindableFunction.Invoke,
            newcclosure(function(self, ...)
                local args = { ... }
                if RemoteAim.enabled and RemoteAim.shotRemotes[self] and currentTarget then
                    local targetPos = currentTarget.worldPos
                    if targetPos then
                        replaceAimValue(args, targetPos)
                    end
                end
                return RemoteAim.originalInvoke(self, table_unpack(args))
            end)
        )
    end)

    return true
end

local function installRemoteHooks()
    if RemoteAim.hookInstalled then return true end
    local ok1 = installNamecallHook()
    local ok2 = installDirectHooks()
    RemoteAim.hookInstalled = ok1 or ok2
    return RemoteAim.hookInstalled
end

local function uninstallRemoteHooks()
    if RemoteAim.originalNamecall then
        pcall(function()
            local mt = getrawmetatable(game)
            if mt and mt.__namecall then
                setreadonly(mt, false)
                mt.__namecall = RemoteAim.originalNamecall
                setreadonly(mt, true)
            end
        end)
        RemoteAim.originalNamecall = nil
    end
    RemoteAim.originalFireServer = nil
    RemoteAim.originalInvokeServer = nil
    RemoteAim.originalFire = nil
    RemoteAim.originalInvoke = nil
    for _, key in ipairs({ "dummyRemote", "dummyUnreliable", "dummyRemoteFunction", "dummyBindableEvent", "dummyBindableFunction" }) do
        local inst = RemoteAim[key]
        if inst then pcall(function() inst:Destroy() end) end
        RemoteAim[key] = nil
    end
    RemoteAim.hookInstalled = false
end

