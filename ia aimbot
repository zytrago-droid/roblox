local Config  -- forward decl (assigned below)

local SAVE_FILE = "aimbot_config.json"
local SaveData = {}

local function loadSave()
    if not readfile then return end
    pcall(function()
        if isfile and not isfile(SAVE_FILE) then return end
        local raw = readfile(SAVE_FILE)
        if type(raw) ~= "string" or raw == "" then return end
        local decoded = HttpService:JSONDecode(raw)
        if type(decoded) ~= "table" then return end
        SaveData = decoded
    end)
end

local function writeSave()
    if not writefile or not Config then return end

    SaveData.HoldToAim     = Config.HoldToAim
    SaveData.TeamCheck     = Config.TeamCheck
    SaveData.VisibleCheck  = Config.VisibleCheck
    SaveData.UsePrediction = Config.UsePrediction
    SaveData.TargetPlayers = Config.TargetPlayers
    SaveData.TargetNPCs    = Config.TargetNPCs
    SaveData.EnemyOnly     = Config.EnemyOnly

    SaveData.FOVRadius       = Config.FOVRadius
    SaveData.Smoothing       = Config.Smoothing
    SaveData.Prediction      = Config.Prediction
    SaveData.HRPJitterRadius = Config.HRPJitterRadius

    SaveData.TargetPart = Config.TargetPart
    SaveData.TargetMode = Config.TargetMode

    SaveData.CircleColor = string.format("%d,%d,%d",
        math.floor(Config.CircleColor.R * 255 + 0.5),
        math.floor(Config.CircleColor.G * 255 + 0.5),
        math.floor(Config.CircleColor.B * 255 + 0.5))

    if Config.AimbotBind.kind == "key" then
        SaveData.AimbotBindKind  = "key"
        SaveData.AimbotBindName  = Config.AimbotBind.code.Name
        SaveData.AimbotBindIndex = nil
    else
        SaveData.AimbotBindKind  = "mouse"
        SaveData.AimbotBindName  = nil
        SaveData.AimbotBindIndex = Config.AimbotBind.index
    end

    pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(SaveData))
    end)
end

local saveQueued = false
local function saveSoon()
    if saveQueued then return end
    saveQueued = true
    task.defer(function()
        saveQueued = false
        writeSave()
    end)
end

