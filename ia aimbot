-- ============================================================
-- BIND HELPERS
-- ============================================================
local function keyBind(code) return { kind = "key", code = code } end
local function mouseBind(index) return { kind = "mouse", index = index } end

local function bindLabel(b)
    if b.kind == "key" then return b.code.Name end
    return "M" .. tostring(b.index)
end

local mouseHeld = { [1] = false, [2] = false, [3] = false, [4] = false, [5] = false }
local m45Seen   = { [4] = false, [5] = false }

local function extractMouseIndex(ut)
    if not ut then return nil end
    local okName, nm = pcall(function() return ut.Name end)
    if okName and nm then
        local idx = tonumber(nm:match("MouseButton(%d+)"))
        if idx then return idx end
    end
    local okVal, val = pcall(function() return ut.Value end)
    if okVal and val and val >= 1 and val <= 5 then return val end
    return nil
end

local function isBindDown(b)
    if b.kind == "key" then
        local ok, down = pcall(function() return UserInputService:IsKeyDown(b.code) end)
        return ok and down
    else
        if mouseHeld[b.index] then return true end
        local ok, down = pcall(function()
            return UserInputService:IsMouseButtonPressed(b.index)
        end)
        return ok and down
    end
end

