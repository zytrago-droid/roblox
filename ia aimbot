            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    set[teamKeyOf(plr)] = true
                end
            end
            local arr = {}
            for k in pairs(set) do arr[#arr + 1] = k end
            table_sort(arr)
            return arr
        end

        local function rebuild()
            for _, r in ipairs(rows) do
                pcall(function() r:Destroy() end)
            end
            rows = {}

            local teams = collectTeams()
            if #teams == 0 then
                local empty = Instance.new("TextLabel")
                empty.Size = UDim2.new(1, 0, 0, 24)
                empty.BackgroundTransparency = 1
                empty.Text = "no teams"
                empty.TextColor3 = Colors.Muted
                empty.Font = Enum.Font.Gotham
                empty.TextSize = 11
                empty.Parent = scroll
                rows[#rows + 1] = empty
                return
            end

            for i, key in ipairs(teams) do
                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, 0, 0, 26)
                row.BackgroundColor3 = Colors.Surface2
                row.BorderSizePixel = 0
                row.LayoutOrder = i
                row.Parent = scroll
                Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

                local nameLbl = Instance.new("TextLabel")
                nameLbl.Size = UDim2.new(1, -60, 1, 0)
                nameLbl.Position = UDim2.new(0, 8, 0, 0)
                nameLbl.BackgroundTransparency = 1
                nameLbl.Text = (key == "__none") and "(no team)" or key
                nameLbl.TextColor3 = Colors.Text
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                nameLbl.Font = Enum.Font.Gotham
                nameLbl.TextSize = 11
                nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
                nameLbl.Parent = row

                local tBtn = Instance.new("TextButton")
                tBtn.Size = UDim2.new(0, 44, 1, -8)
                tBtn.Position = UDim2.new(1, -48, 0, 4)
                tBtn.BackgroundColor3 = Colors.Surface
                tBtn.BorderSizePixel = 0
                tBtn.AutoButtonColor = false
                tBtn.Text = "OFF"
                tBtn.Font = Enum.Font.GothamBold
                tBtn.TextSize = 10
                tBtn.TextColor3 = Colors.Muted
                tBtn.Parent = row
                Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 4)

                local function render()
                    if SelectedTeams[key] then
                        row.BackgroundColor3 = Colors.FriendBg
                        tBtn.BackgroundColor3 = Colors.Friend
                        tBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        tBtn.Text = "ON"
                    else
                        row.BackgroundColor3 = Colors.Surface2
                        tBtn.BackgroundColor3 = Colors.Surface
                        tBtn.TextColor3 = Colors.Muted
                        tBtn.Text = "OFF"
                    end
                end

                track(tBtn.MouseButton1Click:Connect(function()
                    if SelectedTeams[key] then
                        SelectedTeams[key] = nil
                    else
                        SelectedTeams[key] = true
                    end
                    recalcTeamFilter()
                    saveTeams()
                    render()
                end))

                render()
                rows[#rows + 1] = row
            end
        end

        rebuild()

        local function hookTeam(plr)
            track(plr:GetPropertyChangedSignal("Team"):Connect(function()
                task_wait(0.05)
                if not closed then rebuild() end
            end))
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then hookTeam(plr) end
        end

        track(Players.PlayerAdded:Connect(function(plr)
            hookTeam(plr)
            task_wait(0.2)
            if not closed then rebuild() end
        end))
        track(Players.PlayerRemoving:Connect(function()
            task_wait(0.2)
            if not closed then rebuild() end
        end))

        return container
    end

    local function makePlayerPrefsSection(order)
        local container = Instance.new("Frame")
        container.Size = UDim2.new(1, 0, 0, 190)
        container.BackgroundColor3 = Colors.Surface
        container.BackgroundTransparency = 0.4
        container.BorderSizePixel = 0
        container.LayoutOrder = order
        container.ClipsDescendants = true
        container.Parent = content
        Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)

        local search = Instance.new("TextBox")
        search.Size = UDim2.new(1, -10, 0, 24)
        search.Position = UDim2.new(0, 5, 0, 5)
        search.BackgroundColor3 = Colors.Surface2
        search.BorderSizePixel = 0
        search.Font = Enum.Font.Gotham
        search.TextSize = 11
        search.TextColor3 = Colors.Text
        search.PlaceholderText = "search player..."
        search.PlaceholderColor3 = Colors.Muted
        search.Text = ""
        search.ClearTextOnFocus = false
        search.TextXAlignment = Enum.TextXAlignment.Left
        search.Parent = container
        Instance.new("UICorner", search).CornerRadius = UDim.new(0, 4)
        local spad = Instance.new("UIPadding", search)
        spad.PaddingLeft = UDim.new(0, 8)

        local scroll = Instance.new("ScrollingFrame")
        scroll.Size = UDim2.new(1, 0, 1, -34)
        scroll.Position = UDim2.new(0, 0, 0, 34)
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 3
        scroll.ScrollBarImageColor3 = Colors.Accent
        scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.ScrollingDirection = Enum.ScrollingDirection.Y
        scroll.Parent = container

        local padding = Instance.new("UIPadding", scroll)
        padding.PaddingLeft = UDim.new(0, 5)
        padding.PaddingRight = UDim.new(0, 5)
        padding.PaddingTop = UDim.new(0, 5)
        padding.PaddingBottom = UDim.new(0, 5)

        local rowLayout = Instance.new("UIListLayout", scroll)
        rowLayout.Padding = UDim.new(0, 4)
        rowLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local rows = {}

        local function getQuery()
            local t = search.Text
            if type(t) ~= "string" then return "" end
            t = t:lower()
            t = t:gsub("^%s+", ""):gsub("%s+$", "")
            return t
        end

        local function reorderByQuery()
            local q = getQuery()
            if q == "" then
                for i, entry in ipairs(rows) do
                    entry.row.LayoutOrder = i
                    entry.nameLbl.TextColor3 = Colors.Text
                end
                scroll.CanvasPosition = Vector2_new(0, 0)
                return
            end

            local scored = {}
            for i = 1, #rows do
                local entry = rows[i]
                local name = entry.plr.Name:lower()
                local score = levenshtein(q, name)
                if name:find(q, 1, true) then score = score - 1000 end
                scored[#scored + 1] = { entry = entry, score = score }
            end
            table_sort(scored, function(a, b) return a.score < b.score end)

            for i = 1, #scored do
                local s = scored[i]
                s.entry.row.LayoutOrder = i
                if i == 1 then
                    s.entry.nameLbl.TextColor3 = Colors.Accent
                else
                    s.entry.nameLbl.TextColor3 = Colors.Text
                end
            end
            scroll.CanvasPosition = Vector2_new(0, 0)
        end

        local function rebuildPlayerRows()
            for _, entry in ipairs(rows) do
                pcall(function() entry.row:Destroy() end)
            end
            rows = {}

            local idx = 0
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    idx = idx + 1
                    local row = Instance.new("Frame")
                    row.Size = UDim2.new(1, 0, 0, 26)
                    row.BackgroundColor3 = Colors.Surface2
                    row.BorderSizePixel = 0
                    row.LayoutOrder = idx
                    row.Parent = scroll
                    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

                    local nameLbl = Instance.new("TextLabel")
                    nameLbl.Size = UDim2.new(1, -66, 1, 0)
                    nameLbl.Position = UDim2.new(0, 8, 0, 0)
                    nameLbl.BackgroundTransparency = 1
                    nameLbl.Text = plr.Name
                    nameLbl.TextColor3 = Colors.Text
                    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                    nameLbl.Font = Enum.Font.Gotham
                    nameLbl.TextSize = 11
                    nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
                    nameLbl.Parent = row

                    local function miniBtn(txt, xOff)
                        local b = Instance.new("TextButton")
                        b.Size = UDim2.new(0, 22, 1, -8)
                        b.Position = UDim2.new(1, xOff, 0, 4)
                        b.BackgroundColor3 = Colors.Surface
                        b.BorderSizePixel = 0
                        b.AutoButtonColor = false
                        b.Text = txt
                        b.Font = Enum.Font.GothamBold
                        b.TextSize = 11
                        b.TextColor3 = Colors.Muted
                        b.Parent = row
                        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
                        return b
                    end

                    local fBtn = miniBtn("F", -52)
                    local eBtn = miniBtn("E", -26)

                    local function render()
                        local state = PlayerPrefs[tostring(plr.UserId)]
                        if state == "friend" then
                            row.BackgroundColor3 = Colors.FriendBg
                            fBtn.BackgroundColor3 = Colors.Friend
                            fBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                            eBtn.BackgroundColor3 = Colors.Surface
                            eBtn.TextColor3 = Colors.Muted
                        elseif state == "enemy" then
                            row.BackgroundColor3 = Colors.EnemyBg
                            fBtn.BackgroundColor3 = Colors.Surface
                            fBtn.TextColor3 = Colors.Muted
                            eBtn.BackgroundColor3 = Colors.Enemy
                            eBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        else
                            row.BackgroundColor3 = Colors.Surface2
                            fBtn.BackgroundColor3 = Colors.Surface
                            fBtn.TextColor3 = Colors.Muted
                            eBtn.BackgroundColor3 = Colors.Surface
                            eBtn.TextColor3 = Colors.Muted
                        end
                    end

                    local function setState(target)
                        local key = tostring(plr.UserId)
                        if PlayerPrefs[key] == target then
                            PlayerPrefs[key] = nil
                        else
                            PlayerPrefs[key] = target
                        end
                        render()
                        savePrefs()
                    end

                    track(fBtn.MouseButton1Click:Connect(function() setState("friend") end))
                    track(eBtn.MouseButton1Click:Connect(function() setState("enemy")  end))

                    render()
                    rows[#rows + 1] = { plr = plr, row = row, nameLbl = nameLbl }
                end
            end

            reorderByQuery()
        end

        track(search:GetPropertyChangedSignal("Text"):Connect(reorderByQuery))

        rebuildPlayerRows()

        track(Players.PlayerAdded:Connect(function()
            task_wait(0.2)
            if not closed then rebuildPlayerRows() end
        end))
        track(Players.PlayerRemoving:Connect(function()
            task_wait(0.2)
            if not closed then rebuildPlayerRows() end
        end))

        return container
    end

    local order = 0
    local function nextOrder() order = order + 1; return order end

    section("general", nextOrder())
    makeToggle("enabled",       "Enabled",      nextOrder(), "AimbotBind",
        function() return Config.HoldToAim end)
    makeToggle("hold to aim",   "HoldToAim",    nextOrder())
    makeToggle("team check",    "TeamCheck",    nextOrder())
    makeToggle("visible check", "VisibleCheck", nextOrder())

    section("targets", nextOrder())
    makeToggle("players",       "TargetPlayers", nextOrder())
    makeToggle("npc",           "TargetNPCs",    nextOrder())
    makeToggle("enemy only",    "EnemyOnly",     nextOrder())

    section("teams  ·  whitelist", nextOrder())
    makeTeamsSection(nextOrder())

    section("player prefs  ·  F friend / E enemy", nextOrder())
    makePlayerPrefsSection(nextOrder())

    section("tuning", nextOrder())
    makeSlider("fov",        50, 500, function() return Config.FOVRadius end,
        function(v) Config.FOVRadius = v end,
        function(v) return string.format("%d", v) end, nextOrder())

    makeSlider("smoothing",  0.01, 1, function() return Config.Smoothing end,
        function(v) Config.Smoothing = v end,
        function(v) return string.format("%.2f", v) end, nextOrder())

    makeSlider("prediction", 0, 0.5, function() return Config.Prediction end,
        function(v) Config.Prediction = v end,
        function(v) return string.format("%.3f", v) end, nextOrder())

    makeSlider("hrp jitter", 0, 2, function() return Config.HRPJitterRadius end,
        function(v) Config.HRPJitterRadius = v end,
        function(v) return string.format("%.2f", v) end, nextOrder())

    section("aim", nextOrder())
    local parts = { "Head", "HumanoidRootPart", "UpperTorso" }
    local idx = 1
    for i, p in ipairs(parts) do if p == Config.TargetPart then idx = i end end
    makeCycle("part", function() return Config.TargetPart end, function()
        idx = idx % #parts + 1
        Config.TargetPart = parts[idx]
        table_clear(partCache)
    end, nextOrder())

    makeCycle("mode", function() return Config.TargetMode end, function()
        Config.TargetMode = (Config.TargetMode == "Mouse") and "Center" or "Mouse"
    end, nextOrder())

    local dragging, dragStart, startPos = false, nil, nil
    track(titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = panel.Position
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            panel.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if dragging then
                SaveData.panelX = panel.Position.X.Offset
                SaveData.panelY = panel.Position.Y.Offset
                saveSoon()
            end
            dragging = false
        end
    end))

    guiConn = task_spawn(function()
        while not closed do
            for i = 1, #refreshers do
                pcall(refreshers[i])
            end
            if closed then break end
            local active = isActive()
            dot.BackgroundColor3 = active and Colors.Accent or Colors.Muted
            dotGlow.BackgroundTransparency = active and 0.6 or 1
            task_wait(0.05)
        end
    end)
end

pcall(buildGui)

task.defer(function()
    local ok, err = pcall(rebuildCandidates)
    if not ok and err then
        warn("[Aimbot] rebuild failed: " .. tostring(err))
        candidateDirty = true
    end
end)

print("[Aimbot] Loaded. Toggle: " .. bindLabel(Config.AimbotBind) ..
      " | NPC: on | M4/M5 | prefs: F(green) E(red) | teams: whitelist")
