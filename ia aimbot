        if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(child) then
            candidates[#candidates + 1] = child
            candidateSet[child] = true
            candidateTeam[child] = false
            candidateOwner[child] = nil
        end
    end
end

local function onChildRemoved(child)
    if closed then return end
