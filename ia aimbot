scanConn = task_spawn(function()
    local sweepTick = 0
    while not closed do
        if candidateDirty then
            local ok = pcall(rebuildCandidates)
            if not ok then candidateDirty = true end
        end

        if isActive() then
            currentTarget = findTarget()
        else
            currentTarget = nil
        end

        sweepTick = sweepTick + 1
        if sweepTick >= 30 then
            sweepTick = 0
            for part in pairs(hrpJitters) do if not part.Parent then hrpJitters[part] = nil end end
            for model in pairs(partCache) do if not model.Parent then partCache[model] = nil end end
            for remote in pairs(RemoteAim.shotRemotes) do
                if typeof(remote) ~= "Instance" or not remote.Parent then
                    RemoteAim.shotRemotes[remote] = nil
                end
            end
        end
        task_wait(1 / 30)
    end
end)

-- =====================================================================
-- RENDER LOOP
-- =====================================================================
renderConn = RunService.RenderStepped:Connect(function(_dt)
    if closed then return end

    if Config.HoldToAim then
        Config.Held = isBindDown(Config.AimbotBind)
    end

    if not isActive() then
        if fovCircle.Visible then fovCircle.Visible = false end
        currentTarget = nil
        return
    end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        if fovCircle.Visible then fovCircle.Visible = false end
        currentTarget = nil
        return
    end

    local cam = cachedCamera or workspace.CurrentCamera
    if not cam then return end

    if not fovCircle.Visible then fovCircle.Visible = true end
    if Config.FOVRadius ~= lastFovRadius then
        fovCircle.Radius = Config.FOVRadius
        lastFovRadius = Config.FOVRadius
    end
    if Config.CircleColor ~= lastFovColor then
        fovCircle.Color = Config.CircleColor
        lastFovColor = Config.CircleColor
    end

    if Config.TargetMode == "Center" then
        fovCircle.Position = Vector2_new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
    else
        fovCircle.Position = UserInputService:GetMouseLocation()
    end

    if Config.AimMode == "Remote" then return end

    local t = currentTarget
    if t then
        local sp, onScreen = toScreen(t.worldPos)
        if sp and onScreen and sp.Z > 0 then
            local refX, refY
            if Config.TargetMode == "Center" then
                refX = cam.ViewportSize.X * 0.5
                refY = cam.ViewportSize.Y * 0.5
            else
                local ml = UserInputService:GetMouseLocation()
                refX = ml.X
                refY = ml.Y
            end
            local dx = sp.X - refX
            local dy = sp.Y - refY

            local dist3D = (cam.CFrame.Position - t.worldPos).Magnitude
            local maxStep = math_clamp(dist3D * 1.5, 4, 150)
            local smoothFactor = math_clamp(Config.Smoothing, 1, 10)

            local moveX = dx / smoothFactor
            local moveY = dy / smoothFactor
            moveX = math_clamp(moveX, -maxStep, maxStep)
            moveY = math_clamp(moveY, -maxStep, maxStep)

            if math.abs(dx) < 2 and math.abs(dy) < 2 then
                moveX = 0
                moveY = 0
            end

            if mousemoverel and (moveX ~= 0 or moveY ~= 0) then
                pcall(function() mousemoverel(moveX, moveY) end)
            elseif not mousemoverel then
                local desired = CFrame_lookAt(cam.CFrame.Position, t.worldPos)
                local alpha = math_clamp(1 / smoothFactor, 0, 1)
                cam.CFrame = cam.CFrame:Lerp(desired, alpha)
            end
        end
    end
end)

