-- ============================================================
-- SCAN LOOP — 30 Hz
-- ============================================================
scanConn = task_spawn(function()
    local sweepTick = 0
    while not closed do
        if candidateDirty then
            local ok = pcall(rebuildCandidates)
            if not ok then candidateDirty = true end
        end

        local t = findTarget()
        currentTarget = t

        sweepTick = sweepTick + 1
        if sweepTick >= 30 then
            sweepTick = 0
            for part in pairs(hrpJitters) do
                if not part.Parent then hrpJitters[part] = nil end
            end
            for model in pairs(partCache) do
                if not model.Parent then partCache[model] = nil end
            end
        end
        task_wait(1 / 30)
    end
end)

-- ============================================================
-- RENDER LOOP
-- ============================================================
renderConn = RunService.RenderStepped:Connect(function(_dt)
    if closed then return end

    if Config.HoldToAim then
        Config.Held = isBindDown(Config.AimbotBind)
    end

    if not isActive() then
        if fovCircle.Visible then fovCircle.Visible = false end
        currentTarget = nil
        return
    end

    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        if fovCircle.Visible then fovCircle.Visible = false end
        currentTarget = nil
        return
    end

    local cam = cachedCamera or workspace.CurrentCamera
    if not cam then return end

    if not fovCircle.Visible then fovCircle.Visible = true end
    if Config.FOVRadius ~= lastFovRadius then
        fovCircle.Radius = Config.FOVRadius
        lastFovRadius = Config.FOVRadius
    end
    if Config.CircleColor ~= lastFovColor then
        fovCircle.Color = Config.CircleColor
        lastFovColor = Config.CircleColor
    end
    if Config.TargetMode == "Center" then
        fovCircle.Position = Vector2_new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
    else
        fovCircle.Position = UserInputService:GetMouseLocation()
    end

    local t = currentTarget
    if t then
        local desired = CFrame_lookAt(cam.CFrame.Position, t.worldPos)
        local alpha = math_clamp(1 - Config.Smoothing, 0.01, 1)
        cam.CFrame = cam.CFrame:Lerp(desired, alpha)
    end
end)

