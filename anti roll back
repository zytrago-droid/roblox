--// Speed slider
local function paintSpeedSlider()
    local range = CONFIG.MAX_SPEED - CONFIG.MIN_SPEED
    local p = range > 0 and (flySpeed - CONFIG.MIN_SPEED) / range or 0
    sliderBar.Size = UDim2.new(p, 0, 1, 0)
    sliderHandle.Position = UDim2.new(p, -9, 0.5, -9)
    local eff = effectiveSpeed()
    if flySpeed > CONFIG.SAFE_SPEED then
        speedSliderLabel.Text = string.format("Speed: %.0f  (capped %.0f)", flySpeed, eff)
    else
        speedSliderLabel.Text = string.format("Speed: %.0f", flySpeed)
    end
end

local function setSpeed(v)
    flySpeed = math.clamp(v, CONFIG.MIN_SPEED, CONFIG.MAX_SPEED)
    paintSpeedSlider()
end

local function updateSlider(input)
    local width = speedSlider.AbsoluteSize.X
    if width <= 0 then return end
    local x = math.clamp(input.Position.X - speedSlider.AbsolutePosition.X, 0, width)
    local p = x / width
    setSpeed(CONFIG.MIN_SPEED + p * (CONFIG.MAX_SPEED - CONFIG.MIN_SPEED))
end

paintSpeedSlider()

--// Drag
local function makeDraggable(guiObject, dragHandle)
    local dragging, dragStart, startPos
    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            guiObject.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end
makeDraggable(mainFrame, headerFrame)

--// Transparency
local savedTransp = setmetatable({}, {__mode = "k"})

local function applyTransparency()
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if part.Transparency ~= flyTransparency then
                if savedTransp[part] == nil then
                    savedTransp[part] = part.Transparency
                end
                part.Transparency = flyTransparency
            end
        end
    end
end

local function restoreTransparency()
    for part, t in pairs(savedTransp) do
        if part and part.Parent then part.Transparency = t end
    end
    savedTransp = setmetatable({}, {__mode = "k"})
end

--// Helpers
local function getMoveVector()
    local cam = workspace.CurrentCamera
    if not cam then return Vector3.new(0, 0, 0) end
    local cf = cam.CFrame
    local move = cf.LookVector * (CONTROL.F + CONTROL.B)
        + cf.RightVector * (CONTROL.L + CONTROL.R)
        + Vector3.new(0, CONTROL.Q + CONTROL.E, 0)
    if move.Magnitude > 1 then move = move.Unit end
    return move
end

local function getMoverParent()
    if CONFIG.HEAD_PARENT and character then
        local head = character:FindFirstChild("Head")
        if head and head:IsA("BasePart") then return head end
    end
    return rootPart
end

local function destroyBodyMovers()
    if currentGyro then pcall(function() currentGyro:Destroy() end); currentGyro = nil end
    if currentVel  then pcall(function() currentVel:Destroy()  end); currentVel  = nil end
end

local function feedFreefall()
    if not CONFIG.FEED_FREEFALL then return end
    if humanoid and humanoid.Parent then
        pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Freefall) end)
    end
end

local function reaffirmNet()
    if not CONFIG.REAFFIRM_NET or not rootPart then return end
    pcall(function() rootPart:SetNetworkOwner(player) end)
end

--// Start / stop
local function startFly()
    if FLYING then return end
    local rp = getMoverParent()
    if not rp or not humanoid then return end
    FLYING = true
    flyGen += 1
    local gen = flyGen
    smoothVel = Vector3.new(0, 0, 0)

    local lockedRot = (rp.CFrame - rp.CFrame.Position).Rotation

    local gyro = Instance.new("BodyGyro")
    gyro.P = 9e4
    gyro.D = 500
    gyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    gyro.CFrame = rp.CFrame
    gyro.Parent = rp
    currentGyro = gyro

    local vel = Instance.new("BodyVelocity")
    vel.Velocity = Vector3.new(0, 0, 0)
    vel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    vel.Parent = rp
    currentVel = vel

    reaffirmNet()
    applyTransparency()

    bodyLoopConn = RunService.Heartbeat:Connect(function(dt)
        if gen ~= flyGen or not FLYING then
            if bodyLoopConn then bodyLoopConn:Disconnect(); bodyLoopConn = nil end
            destroyBodyMovers()
            resetControls()
            return
        end
        if not rp.Parent then return end

        feedFreefall()

        local desired = getMoveVector() * effectiveSpeed()
        local dv = desired - smoothVel
        local maxDv = CONFIG.ACCEL * dt
        if dv.Magnitude > maxDv then dv = dv.Unit * maxDv end
        smoothVel = smoothVel + dv
        vel.Velocity = smoothVel

        local cam = workspace.CurrentCamera
        if cam then
            local look = cam.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude > 0.05 then
                gyro.CFrame = CFrame.lookAt(rp.Position, rp.Position + flat.Unit)
            else
                gyro.CFrame = CFrame.new(rp.Position) * lockedRot
            end
        else
            gyro.CFrame = CFrame.new(rp.Position) * lockedRot
        end
    end)
end

local function stopFly()
    if not FLYING then return end
    FLYING = false
    flyGen += 1
    if bodyLoopConn then bodyLoopConn:Disconnect(); bodyLoopConn = nil end
    destroyBodyMovers()
    resetControls()
    smoothVel = Vector3.new(0, 0, 0)
    restoreTransparency()
end

local function setFly(state)
    if state then startFly() else stopFly() end
    flyButton.TextColor3 = FLYING and Color3.fromRGB(88, 101, 242) or Color3.fromRGB(255, 255, 255)
    flyStroke.Color = FLYING and Color3.fromRGB(88, 101, 242) or Color3.fromRGB(20, 20, 20)
end

--// Keybinds
local keyMap = {
    [Enum.KeyCode.W] = "F", [Enum.KeyCode.S] = "B",
    [Enum.KeyCode.A] = "L", [Enum.KeyCode.D] = "R",
    [Enum.KeyCode.Q] = "Q", [Enum.KeyCode.E] = "E",
}
local valueMap = {
    [Enum.KeyCode.W] =  1, [Enum.KeyCode.S] = -1,
    [Enum.KeyCode.A] = -1, [Enum.KeyCode.D] =  1,
    [Enum.KeyCode.Q] = -1, [Enum.KeyCode.E] =  1,
}

local function isSpeedUp(kc)
    for _, k in ipairs(SPEED_UP_KEYS) do if kc == k then return true end end
    return false
end
local function isSpeedDown(kc)
    for _, k in ipairs(SPEED_DOWN_KEYS) do if kc == k then return true end end
    return false
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == CONFIG.TOGGLE_KEY then
        setFly(not FLYING)
        return
    end
    if isSpeedUp(input.KeyCode) then
        setSpeed(flySpeed + CONFIG.SPEED_STEP)
        return
    end
    if isSpeedDown(input.KeyCode) then
        setSpeed(flySpeed - CONFIG.SPEED_STEP)
        return
    end
    local k = keyMap[input.KeyCode]
    if k then CONTROL[k] = valueMap[input.KeyCode] end
end)
UserInputService.InputEnded:Connect(function(input)
    local k = keyMap[input.KeyCode]
    if k then CONTROL[k] = 0 end
end)

-- Ctrl+wheel resizes the GUI
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
    if not UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        and not UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then return end
    local nextScale = uiScale.Scale + input.Position.Z * CONFIG.UI_SCALE_STEP
    uiScale.Scale = math.clamp(nextScale, CONFIG.UI_SCALE_MIN, CONFIG.UI_SCALE_MAX)
end)

--// Respawn / death
local function bindHumanoid(h)
    if not h then return end
    h.Died:Connect(function()
        if FLYING then setFly(false) end
    end)
end
