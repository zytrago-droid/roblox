local flyTransparency = CONFIG.DEFAULT_TRANSP
local FLYING          = false
local flyGen          = 0
local bodyLoopConn, currentGyro, currentVel
local smoothVel       = Vector3.new(0, 0, 0)

local CONTROL = {F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0}

local function resetControls()
    CONTROL.F, CONTROL.B, CONTROL.L, CONTROL.R, CONTROL.Q, CONTROL.E = 0, 0, 0, 0, 0, 0
end

local function effectiveSpeed()
    return math.min(flySpeed, CONFIG.SAFE_SPEED)
end

