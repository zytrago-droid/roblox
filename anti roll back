    MIN_SPEED     = 1,
    MAX_SPEED     = 500,
    SAFE_SPEED    = 14,   -- effective speed = min(flySpeed, SAFE_SPEED)
    DEFAULT_SPEED = 50,
    SPEED_STEP    = 10,
    DEFAULT_TRANSP = 0.75,
    ACCEL         = 40,   -- studs/s^2, accel clamp
    FEED_FREEFALL = true,
    REAFFIRM_NET  = true,
