--!native
-- If executor crashes on load, remove the line above

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS        = game:GetService("UserInputService")

local LP  = Players.LocalPlayer
local Cam = workspace.CurrentCamera

local V2, V3       = Vector2.new, Vector3.new
local C3RGB        = Color3.fromRGB
local max          = math.max
local clock        = os.clock

local DEFAULT_COL = C3RGB(255, 255, 255)
local HP_HIGH     = C3RGB(0, 255, 120)
local HP_MED      = C3RGB(255, 200, 50)
local HP_LOW      = C3RGB(255, 60, 60)
local TOOL_COL    = C3RGB(255, 220, 150)
local BG_COL      = Color3.new(0, 0, 0)
local OUTLINE_COL = Color3.new(0, 0, 0)

local FONT_SIZE = 13
local LINE_H    = 15
local PAD       = 3
local T_TEXT    = 0.15

local ENABLED    = true
local SHUTDOWN   = false
local TOGGLE_KEY = Enum.KeyCode.RightShift
local CLOSE_KEY  = Enum.KeyCode.End

local profileBegin = (debug and debug.profilebegin) or function() end
local profileEnd   = (debug and debug.profileend)   or function() end

local Connections = {}
local function track(c) Connections[#Connections+1] = c; return c end

local DIST_CACHE = {}
local function distStr(d)
    local i = d // 1
    local s = DIST_CACHE[i]
    if not s then
        s = i .. "m"
        if i < 2000 then DIST_CACHE[i] = s end
    end
    return s
end

local function newDraw(cls)
    local ok, o = pcall(Drawing.new, cls)
    return ok and o or nil
end

local function setp(obj, prop, val)
    if obj then pcall(function() obj[prop] = val end) end
end

local function hashToColor(str)
    local h = 0
    for i = 1, #str do
        h = (h * 31 + str:byte(i)) % 16777216
    end
    local r = h // 65536 % 256
    local g = h // 256 % 256
    local b = h % 256
    if r + g + b < 300 then
        r = (r + 100 > 255) and 255 or r + 100
        g = (g + 100 > 255) and 255 or g + 100
        b = (b + 100 > 255) and 255 or b + 100
    end
    return C3RGB(r, g, b)
end

local function resolveTeam(plr)
    local t = plr.Team
    if t then
        local tc = plr.TeamColor
        return t.Name, tc and tc.Color or hashToColor(t.Name)
    end
    local ok, v = pcall(function()
        return plr:GetAttribute("Team") or plr:GetAttribute("Job")
            or plr:GetAttribute("Role") or plr:GetAttribute("Class")
    end)
    if ok and v ~= nil then
        local s = tostring(v)
        return s, hashToColor(s)
    end
    local sources = { plr }
    if plr.Character then sources[#sources+1] = plr.Character end
    for _, src in ipairs(sources) do
        for _, name in ipairs({"Team","Job","Role","Class","Occupation"}) do
            local obj = src:FindFirstChild(name)
            if obj and obj:IsA("StringValue") and obj.Value ~= "" then
                return obj.Value, hashToColor(obj.Value)
            end
        end
    end
    return nil, nil
end

local playerList = {}
local function rebuildPlayerList()
    table.clear(playerList)
    for _, plr in ipairs(Players:GetPlayers()) do
        playerList[#playerList+1] = plr
    end
end

local cache, freePool = {}, {}

local function buildObjs()
    local o = {}
    o.bg = newDraw("Square")
    if o.bg then
        o.bg.Filled = true
        o.bg.Color = BG_COL
        o.bg.Transparency = 0.5
        o.bg.Visible = false
    end
    o.l1 = newDraw("Text")
    o.l2 = newDraw("Text")
    o.l3 = newDraw("Text")
    for _, t in ipairs({o.l1, o.l2, o.l3}) do
        if t then
            t.Center = true
            t.Outline = true
            t.OutlineColor = OUTLINE_COL
            t.Size = FONT_SIZE
            t.Visible = false
        end
    end
    pcall(function()
        if Drawing.Fonts then
            local f = Drawing.Fonts.Plex or Drawing.Fonts.System
            if o.l1 then o.l1.Font = f end
            if o.l2 then o.l2.Font = f end
            if o.l3 then o.l3.Font = f end
        end
    end)
    o.char=nil; o.head=nil; o.hrp=nil; o.hum=nil
    o.teamName=nil; o.teamCol=nil; o.lastTeam=nil
    o.tText=0; o.lastTool=nil
    o.bw=nil
    return o
end

local function resetObj(o)
    o.char=nil; o.head=nil; o.hrp=nil; o.hum=nil
    o.teamName=nil; o.teamCol=nil; o.lastTeam=nil
    o.tText=0; o.lastTool=nil
    o.bw=nil
    setp(o.bg, "Visible", false)
    setp(o.l1, "Visible", false)
    setp(o.l2, "Visible", false)
    setp(o.l3, "Visible", false)
end

local function removeObj(o)
    for _, key in ipairs({"bg","l1","l2","l3"}) do
        local obj = o[key]
        if obj then pcall(function() obj:Remove() end) end
    end
end

local function getObjs(plr)
    local o = cache[plr]
    if not o then
        o = table.remove(freePool, 1)
        if o then resetObj(o) else o = buildObjs() end
        cache[plr] = o
    end
    return o
end

local function hideAll(o)
    setp(o.bg, "Visible", false)
    setp(o.l1, "Visible", false)
    setp(o.l2, "Visible", false)
    setp(o.l3, "Visible", false)
end

local function textWidth(t, fallback)
    if not t then return fallback end
    local ok, tb = pcall(function() return t.TextBounds end)
    if ok and tb and tb.X and tb.X > 0 then return tb.X end
    return fallback
end

local function resolveChar(plr, o)
    local char = plr.Character
    if o.char == char and o.head and o.head.Parent == char then return true end
    o.char = char
    if not char then o.head=nil; o.hrp=nil; o.hum=nil; return false end
    o.head = char:FindFirstChild("Head")
    o.hrp  = char:FindFirstChild("HumanoidRootPart")
    o.hum  = char:FindFirstChildOfClass("Humanoid")
    return o.head ~= nil and o.hrp ~= nil and o.hum ~= nil
end

local function renderOne(plr, vp, camPos, now)
    local o = getObjs(plr)
    if plr == LP then hideAll(o); return end
    if not resolveChar(plr, o) then hideAll(o); return end
    if o.hum.Health <= 0 then hideAll(o); return end

    local p3 = Cam:WorldToViewportPoint(o.head.Position + V3(0, 2.2, 0))
    if p3.Z <= 0 then hideAll(o); return end
    local margin = 200
    if p3.X < -margin or p3.X > vp.X + margin
    or p3.Y < -margin or p3.Y > vp.Y + margin then
        hideAll(o); return
    end

    local doText = now >= o.tText
    if doText then
        o.tText = now + T_TEXT

        if o.lastTeam ~= plr.Team or o.teamCol == nil then
            o.lastTeam = plr.Team
            o.teamName, o.teamCol = resolveTeam(plr)
        end

        local tool = o.char:FindFirstChildOfClass("Tool")
        o.lastTool = tool and tool.Name or nil

        local teamCol  = o.teamCol or DEFAULT_COL
        local teamName = o.teamName
        o.l1.Text  = teamName and ("[" .. teamName .. "] " .. plr.Name) or plr.Name
        o.l1.Color = teamCol
        if o.lastTool then
            o.l2.Text  = o.lastTool
            o.l2.Color = TOOL_COL
        end
        local pct = o.hum.Health / o.hum.MaxHealth
        local hpCol = pct > 0.5 and HP_HIGH or pct > 0.25 and HP_MED or HP_LOW
        o.l3.Text  = (o.hum.Health // 1) .. " HP  ·  " .. distStr((o.hrp.Position - camPos).Magnitude)
        o.l3.Color = hpCol

        local w1 = textWidth(o.l1, #o.l1.Text * 8)
        local w3 = textWidth(o.l3, #o.l3.Text * 8)
        local bw = max(w1, w3)
        if o.lastTool then bw = max(bw, textWidth(o.l2, #o.lastTool * 8)) end
        o.bw = bw + 10
    end

    local hasTool = o.lastTool ~= nil
    local lines   = 2 + (hasTool and 1 or 0)
    local blockH  = PAD * 2 + lines * LINE_H
    local x = p3.X
    local y = p3.Y - blockH - 6

    o.l1.Position = V2(x, y + PAD); o.l1.Visible = true

    local ny = y + PAD + LINE_H
    if hasTool then
        o.l2.Position = V2(x, ny); o.l2.Visible = true
        ny = ny + LINE_H
    else
        o.l2.Visible = false
    end
    o.l3.Position = V2(x, ny); o.l3.Visible = true

    if o.bw then
        o.bg.Size     = V2(o.bw, blockH)
        o.bg.Position = V2(x - o.bw / 2, y)
        o.bg.Visible  = true
    else
        o.bg.Visible = false
    end
end

local function shutdown()
    SHUTDOWN = true
    ENABLED  = false
    for plr, o in pairs(cache) do
        hideAll(o)
        removeObj(o)
        cache[plr] = nil
    end
    for _, o in ipairs(freePool) do
        removeObj(o)
    end
    freePool = {}
    for _, c in ipairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    Connections = {}
    print("[ESP] Shutdown.")
end

track(RunService.Heartbeat:Connect(function()
    if SHUTDOWN or not ENABLED then
        if not SHUTDOWN then
            for _, o in pairs(cache) do hideAll(o) end
        end
        return
    end
    local now    = clock()
    local camPos = Cam.CFrame.Position
    local vp     = Cam.ViewportSize

    profileBegin("ESP_Render")
    for i = 1, #playerList do
        local plr = playerList[i]
        if plr then pcall(renderOne, plr, vp, camPos, now) end
    end
    profileEnd()
end))

track(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    if workspace.CurrentCamera then Cam = workspace.CurrentCamera end
end))

track(Players.PlayerAdded:Connect(function() rebuildPlayerList() end))
track(Players.PlayerRemoving:Connect(function(plr)
    local o = cache[plr]
    if o then
        hideAll(o)
        cache[plr] = nil
        freePool[#freePool+1] = o
    end
    rebuildPlayerList()
end))
rebuildPlayerList()

track(UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if SHUTDOWN then return end
    if input.KeyCode == TOGGLE_KEY then
        ENABLED = not ENABLED
        if not ENABLED then
            for _, o in pairs(cache) do hideAll(o) end
        end
        print("[ESP] " .. (ENABLED and "ON" or "OFF"))
    elseif input.KeyCode == CLOSE_KEY then
        shutdown()
    end
end))

print("[ESP] Loaded. RightShift = toggle, End = shutdown.")
