-- ^ / $ on AZERTY = LeftBracket / RightBracket. On QWERTY = Six / Four.
local SPEED_UP_KEYS   = {Enum.KeyCode.Six, Enum.KeyCode.LeftBracket}
local SPEED_DOWN_KEYS = {Enum.KeyCode.Four, Enum.KeyCode.RightBracket}

