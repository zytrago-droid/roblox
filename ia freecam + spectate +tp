track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if scriptDestroyed then return end

    if listeningForBind and input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == Enum.KeyCode.Escape then
            listeningForBind = false
            keybindBtn.Text = "🔑  Key: " .. tostring(freecamKey.Name)
            keybindBtn.BackgroundColor3 = C_SURFACE_2
        elseif RESERVED_KEYS[input.KeyCode] then
            keybindBtn.Text = "⚠  Touche réservée"
            task.delay(0.9, function()
                if keybindBtn and keybindBtn.Parent and not listeningForBind then
                    keybindBtn.Text = "🔑  Key: " .. tostring(freecamKey.Name)
                    keybindBtn.BackgroundColor3 = C_SURFACE_2
                end
            end)
        else
            freecamKey = input.KeyCode
            listeningForBind = false
            keybindBtn.Text = "🔑  Key: " .. freecamKey.Name
            keybindBtn.BackgroundColor3 = C_SURFACE_2
            flash(keybindBtn, C_GREEN, 0.2)
        end
        return
    end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        keysDown[input.KeyCode] = true
        if spectateActive and (input.KeyCode == Enum.KeyCode.Escape
            or input.KeyCode == Enum.KeyCode.Backspace) then
            stopSpectate(); return
        end
    end
    if gameProcessed then return end

    if freecamKey and input.KeyCode == freecamKey then
        if freecamActive then disableFreecam() else enableFreecam() end
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        keysDown[input.KeyCode] = nil
