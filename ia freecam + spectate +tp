updateCardSizes = function()
    task.defer(function()
        if not panel or not panel.Parent then return end
        local H = panel.AbsoluteSize.Y
        local specH = math.max(240, H - 258)
        spectateCard.Size = UDim2.new(1, 0, 0, specH)
        local extra = spectateStopBtn.Visible and 40 or 0
        local listH = math.max(100, specH - 84 - extra)
        spectateList.Size = UDim2.new(1, 0, 0, listH)
    end)
end

