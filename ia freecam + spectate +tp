-- ============================================================
-- §7. DRAG + RESIZE
-- ============================================================
track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if scriptDestroyed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
       and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local mp = input.Position

    if resizeHandle and resizeHandle.Parent then
        local rp = resizeHandle.AbsolutePosition
        local rs = resizeHandle.AbsoluteSize
        if mp.X >= rp.X and mp.X <= rp.X + rs.X
           and mp.Y >= rp.Y and mp.Y <= rp.Y + rs.Y then
            isResizing = true
            resizeStart = mp
            resizeStartSize = { W = panel.AbsoluteSize.X, H = panel.AbsoluteSize.Y }
            resizeHandle.TextColor3 = C_TEXT
            return
        end
    end

    if gameProcessed then return end
    if not header or not header.Parent then return end

    local hp = header.AbsolutePosition
    local hs = header.AbsoluteSize
    if mp.X >= hp.X and mp.X <= hp.X + hs.X
       and mp.Y >= hp.Y and mp.Y <= hp.Y + hs.Y then
        if closeBtn and closeBtn.Parent then
            local cp = closeBtn.AbsolutePosition
            local cs = closeBtn.AbsoluteSize
            if mp.X >= cp.X and mp.X <= cp.X + cs.X
               and mp.Y >= cp.Y and mp.Y <= cp.Y + cs.Y then
                return
            end
        end
        isDragging = true
        dragStart = mp
        dragStartPos = panel.Position
    end
end))

track(UserInputService.InputChanged:Connect(function(input)
    if scriptDestroyed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then return end

    if isResizing then
        if not resizeStart or not resizeStartSize then return end
        local d = input.Position - resizeStart
        local newW = math.max(MIN_W, resizeStartSize.W + d.X)
        local newH = math.max(MIN_H, resizeStartSize.H + d.Y)
        panel.Size = UDim2.new(0, newW, 0, newH)
        updateCardSizes()
        return
    end

    if isDragging then
        if not dragStart or not dragStartPos then return end
        local d = input.Position - dragStart
        panel.Position = UDim2.new(
            dragStartPos.X.Scale, dragStartPos.X.Offset + d.X,
            dragStartPos.Y.Scale, dragStartPos.Y.Offset + d.Y
        )
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
        dragStart = nil
        dragStartPos = nil
        if isResizing then
            isResizing = false
            resizeStart = nil
            resizeStartSize = nil
            if resizeHandle and resizeHandle.Parent then
                resizeHandle.TextColor3 = C_TEXT_MUTED
            end
        end
    end
end))

