enableFreecam = function()
    if scriptDestroyed or freecamActive then return end
    local char, hum, hrp = getLocalCharacter()
    if not char or not hum or not hrp then return end
    if hum.Health <= 0 then return end
    if spectateActive then stopSpectate() end

    hrp.Anchored = true
    savedAutoRotate = hum.AutoRotate
    hum.AutoRotate = false
    setCharacterVisible(char)

    Camera.CameraSubject = hum
    Camera.CameraType   = Enum.CameraType.Scriptable

    local camCF = Camera.CFrame
    freecamPos   = camCF.Position
    local rx, ry = camCF:ToEulerAnglesYXZ()
    freecamPitch = rx
    freecamYaw   = ry

    freecamActive = true
    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter

    freecamStatus.Text = "● Actif — WASD + souris"
    freecamStatus.TextColor3 = C_GREEN
    freecamBtn.Text = "Disable Freecam"
    TweenService:Create(freecamBtn, TweenInfo.new(0.2),
        { BackgroundColor3 = C_GREEN }):Play()
    freecamIndicator.Visible = true
    updateSpeedDisplay()
end

disableFreecam = function()
    if not freecamActive then return end
    freecamActive = false

    local char, hum, hrp = getLocalCharacter()
    if char then
        if hrp and hrp.Parent then
            pcall(function() hrp.Anchored = false end)
        end
        if hum and hum.Parent then
            pcall(function() hum.AutoRotate = savedAutoRotate end)
            if hum.Health > 0 then Camera.CameraSubject = hum end
        end
    end

    restoreCharacterVisibility()
    Camera.CameraType = Enum.CameraType.Custom
    pcall(function()
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end)

    if not scriptDestroyed and freecamStatus and freecamStatus.Parent then
        freecamStatus.Text = "Status: OFF"
        freecamStatus.TextColor3 = C_TEXT_MUTED
        freecamBtn.Text = "Enable Freecam"
        TweenService:Create(freecamBtn, TweenInfo.new(0.2),
            { BackgroundColor3 = C_SURFACE_2 }):Play()
        freecamIndicator.Visible = false
    end
end

local function updateFreecam(dt)
    if Camera.CameraType ~= Enum.CameraType.Scriptable then
        Camera.CameraType = Enum.CameraType.Scriptable
    end
    if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    end

    for part, _ in pairs(savedTransparency) do
        if part and part.Parent and part:IsA("BasePart") then
            part.LocalTransparencyModifier = 0
        end
    end

    local d = UserInputService:GetMouseDelta()
    freecamYaw   = freecamYaw   - d.X * FREECAM_SENSITIVITY
    freecamPitch = math.clamp(freecamPitch - d.Y * FREECAM_SENSITIVITY,
        -math.rad(89), math.rad(89))

    local rot = CFrame.fromEulerAnglesYXZ(freecamPitch, freecamYaw, 0)

    local move = Vector3.zero
    if isDown(Enum.KeyCode.W) then move += rot.LookVector  end
    if isDown(Enum.KeyCode.S) then move -= rot.LookVector  end
    if isDown(Enum.KeyCode.D) then move += rot.RightVector end
    if isDown(Enum.KeyCode.A) then move -= rot.RightVector end
    if isDown(Enum.KeyCode.E) or isDown(Enum.KeyCode.Space) then
        move += Vector3.yAxis
    end
    if isDown(Enum.KeyCode.Q) or isDown(Enum.KeyCode.LeftShift) then
        move -= Vector3.yAxis
    end
    if move.Magnitude > 0 then move = move.Unit end

    local spd = freecamSpeed
    if isDown(Enum.KeyCode.LeftAlt)     then spd *= 3    end
    if isDown(Enum.KeyCode.LeftControl) then spd *= 0.25 end

    freecamPos += move * spd * dt
    local cf = CFrame.new(freecamPos) * rot
    Camera.CFrame = cf
    Camera.Focus = cf
end

-- ============================================================
-- §12. SPECTATE
-- ============================================================
local function smoothed(alpha, dt)
    return 1 - (1 - alpha) ^ (dt * 60)
end

updateSpectateCamera = function(dt)
    if not spectateActive or not spectateTarget then return end
    if Camera.CameraType ~= Enum.CameraType.Scriptable then
        Camera.CameraType = Enum.CameraType.Scriptable
    end

    local orb = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if orb then
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end
        local d = UserInputService:GetMouseDelta()
        spectateYaw = spectateYaw - d.X * SPECTATE_SENSITIVITY
        spectateElevation = math.clamp(
            spectateElevation - d.Y * SPECTATE_SENSITIVITY,
            -math.rad(89), math.rad(89))
    else
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end

    local char = spectateTarget.Character
    if not char then
        if spectateIndicator and spectateIndicator.Parent then
            spectateIndicator.Text = "👁  " .. spectateTarget.DisplayName .. " (hors portée)"
        end
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        if spectateIndicator and spectateIndicator.Parent then
            spectateIndicator.Text = "👁  " .. spectateTarget.DisplayName .. " (cible morte)"
        end
        return
    end

    local anchor = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not anchor then return end

    local hOff = math.max(1, spectateDistance * 0.15)
    local tPos = anchor.Position + Vector3.new(0, hOff, 0)
    local rot  = CFrame.fromEulerAnglesYXZ(-spectateElevation, spectateYaw, 0)
    local cPos = tPos + rot * Vector3.new(0, 0, spectateDistance)
    local goal = CFrame.lookAt(cPos, tPos)

    if not currentOrbitCF then currentOrbitCF = goal
    else currentOrbitCF = currentOrbitCF:Lerp(goal, smoothed(SPECTATE_SMOOTH, dt)) end

    Camera.CFrame = currentOrbitCF
    Camera.Focus = currentOrbitCF

    if spectateIndicator and spectateIndicator.Parent then
        local hint = orb and "relâche = clic" or "clic droit = orbite"
        spectateIndicator.Text = string.format("👁  %s  ·  %d studs  ·  %s",
            spectateTarget.DisplayName, math.floor(spectateDistance), hint)
    end
end

startSpectate = function(player)
    if scriptDestroyed then return end
    if not player or player == LocalPlayer then return end
    if freecamActive then disableFreecam() end

    spectateTarget = player
    spectateActive = true
    currentOrbitCF = nil
    Camera.CameraType = Enum.CameraType.Scriptable
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    releaseTextFocus()

    local char = player.Character
    local anchor = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
    if anchor then
        local hOff = math.max(1, spectateDistance * 0.15)
        local tPos = anchor.Position + Vector3.new(0, hOff, 0)
        local off  = Camera.CFrame.Position - tPos
        if off.Magnitude > 0.5 then
            local dir = off.Unit
            spectateElevation = math.asin(math.clamp(dir.Y, -1, 1))
            spectateYaw = math.atan2(dir.X, dir.Z)
            spectateDistance = math.clamp(off.Magnitude, SPECTATE_MIN_DIST, SPECTATE_MAX_DIST)
        else
            spectateYaw = 0; spectateElevation = 0
        end
    else
        spectateYaw = 0; spectateElevation = 0
    end

    spectateStopBtn.Visible = true
    spectateIndicator.Visible = true
    quickStopBtn.Visible = true
    updateCardSizes()

    local r = playerRows[player]
    if r and r.specBtn then
        r.specBtn.BackgroundColor3 = C_RED
        r.specBtn.Text = "⏹"
    end

    updateSpectateCamera(1/60)
end

stopSpectate = function()
    if not spectateActive then return end
    local now = os.clock()
    if now - lastStopTime < STOP_DEBOUNCE then return end
    lastStopTime = now

    if spectateTarget then
        local r = playerRows[spectateTarget]
        if r and r.specBtn and r.specBtn.Parent then
            r.specBtn.BackgroundColor3 = C_BLUE
            r.specBtn.Text = "👁"
        end
    end

    spectateActive = false
    spectateTarget = nil
    currentOrbitCF = nil

    local char, hum = getLocalCharacter()
    if char and hum and hum.Health > 0 then Camera.CameraSubject = hum end
    Camera.CameraType = Enum.CameraType.Custom
    pcall(function()
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end)

    if not scriptDestroyed then
        if spectateStopBtn and spectateStopBtn.Parent then spectateStopBtn.Visible = false end
        if spectateIndicator and spectateIndicator.Parent then spectateIndicator.Visible = false end
        if quickStopBtn and quickStopBtn.Parent then quickStopBtn.Visible = false end
        updateCardSizes()
    end
end

