local function applyFilter()
    if not searchBox or not searchBox.Parent then return end
    local q = string.lower(searchBox.Text or "")
    for player, data in pairs(playerRows) do
        if data.row and data.row.Parent then
            local hay = string.lower(player.DisplayName .. " " .. player.Name)
            data.row.Visible = (q == "") or (string.find(hay, q, 1, true) ~= nil)
        end
    end
end

