for _, p in ipairs(Players:GetPlayers()) do addPlayerRow(p) end
track(Players.PlayerAdded:Connect(addPlayerRow))
track(Players.PlayerRemoving:Connect(removePlayerRow))

-- ============================================================
-- RESPAWN / MORT
-- ============================================================
local function watchCharacter(char)
    local hum = char:WaitForChild("Humanoid", 8)
    if not hum then return end
    track(hum.Died:Connect(function()
        if freecamActive then disableFreecam() end
        if spectateActive then stopSpectate() end
    end))
end
if LocalPlayer.Character then watchCharacter(LocalPlayer.Character) end
track(LocalPlayer.CharacterAdded:Connect(function(char)
    if scriptDestroyed then return end
    if freecamActive then disableFreecam() end
    if spectateActive then stopSpectate() end
    watchCharacter(char)
end))

-- ============================================================
-- BOUCLE RENDU — priorité 2000 (Last) en valeur directe
-- ============================================================
RunService:BindToRenderStep(RENDER_STEP_NAME, 2000, function(dt)
    if scriptDestroyed then return end
    if freecamActive then
        updateFreecam(dt)
    elseif spectateActive then
        updateSpectateCamera(dt)
    end
end)

-- ============================================================
-- FERMETURE PROPRE
-- ============================================================
function destroyScript()
    if scriptDestroyed then return end
    scriptDestroyed = true

    pcall(function() if freecamActive then disableFreecam() end end)
    pcall(function() if spectateActive then stopSpectate() end end)

    pcall(function()
        local char, hum = getLocalCharacter()
        if char and hum and hum.Parent then
            hum.AutoRotate = savedAutoRotate
            if hum.Health > 0 then
                Camera.CameraSubject = hum
            end
            Camera.CameraType = Enum.CameraType.Custom
        end
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end)

    pcall(function()
        local _, _, hrp = getLocalCharacter()
        if hrp and hrp.Parent then hrp.Anchored = false end
    end)
    pcall(restoreCharacterVisibility)

    pcall(function() RunService:UnbindFromRenderStep(RENDER_STEP_NAME) end)

    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    connections = {}

    keysDown = {}
    playerRows = {}
    thumbnailCache = {}
    thumbLoading = {}
    savedTransparency = {}
    spectateTarget = nil
    currentOrbitCF = nil
    spectateYaw = 0
    spectateElevation = 0
    freecamActive = false
    spectateActive = false

    pcall(function() if screenGui then screenGui:Destroy() end end)
    screenGui = nil

    print("[Freecam+Spectate] Script fermé proprement.")
end
