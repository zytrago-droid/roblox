local function addPlayerRow(player)
    if scriptDestroyed then return end
    if player == LocalPlayer then return end
    if playerRows[player] then return end
    playerRows[player] = createRow(player)
    track(player.CharacterAppearanceLoaded:Connect(function()
        local r = playerRows[player]
        if r and r.head and r.head.Parent then
            thumbnailCache[player.UserId] = nil
            r.head.Image = getThumb(player, true)
        end
    end))
    applyFilter()
    updateCanvasSize()
end

