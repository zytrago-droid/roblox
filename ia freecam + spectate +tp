-- §7. TP
-- ============================================================
doTP = function(player)
    if player == LocalPlayer then return end
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local tChar = player.Character
    local tHRP  = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not tHRP then return end

    local before = hrp.Position
    pcall(function()
        hrp.CFrame = tHRP.CFrame * CFrame.new(0, 0, TP_OFFSET_STUDS)
    end)

    task.delay(0.3, function()
        if hrp and hrp.Parent and (hrp.Position - before).Magnitude < 1 then
            if spectateIndicator and spectateIndicator.Parent then
                spectateIndicator.Text = "⚠  TP bloqué (anti-cheat ?)"
                spectateIndicator.BackgroundColor3 = C_ORANGE
                spectateIndicator.Visible = true
                task.delay(2, function()
                    if spectateIndicator and spectateIndicator.Parent
                        and not spectateActive then
                        spectateIndicator.Visible = false
                        spectateIndicator.BackgroundColor3 = C_BLUE
                    end
                end)
            end
        end
    end)
end

