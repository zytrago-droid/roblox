local function getLocalCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char,
           char:FindFirstChildOfClass("Humanoid"),
           char:FindFirstChild("HumanoidRootPart")
end

local function getThumb(player, forceRefresh)
    local uid = player.UserId
    if not forceRefresh and thumbnailCache[uid] then
        return thumbnailCache[uid]
    end
    if thumbLoading[uid] then
        return "https://www.roblox.com/headshot-thumbnail/image?userId="
            .. tostring(uid) .. "&width=420&height=420&format=png"
    end
    thumbLoading[uid] = true
    local ok, result = pcall(function()
        return Players:GetUserThumbnailAsync(uid,
            Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
    end)
    thumbLoading[uid] = nil
    local url
    if ok and type(result) == "string" and #result > 0 then
        url = result
    else
        url = "https://www.roblox.com/headshot-thumbnail/image?userId="
            .. tostring(uid) .. "&width=420&height=420&format=png"
    end
    thumbnailCache[uid] = url
    return url
end

local function isDown(code)
    return keysDown[code] == true or UserInputService:IsKeyDown(code)
end

local function setCharacterVisible(char)
    if not char then return end
    savedTransparency = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            savedTransparency[part] = part.LocalTransparencyModifier
            part.LocalTransparencyModifier = 0
        end
    end
end

local function restoreCharacterVisibility()
    for part, val in pairs(savedTransparency) do
        if part and part.Parent then
            pcall(function() part.LocalTransparencyModifier = val end)
        end
    end
    savedTransparency = {}
end

local function releaseTextFocus()
    local focused = UserInputService:GetFocusedTextBox()
    if focused then pcall(function() focused:ReleaseFocus() end) end
end

