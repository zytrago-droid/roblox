-- FREECAM
-- ============================================================
function enableFreecam()
    if scriptDestroyed or freecamActive then return end
    local char, hum, hrp = getLocalCharacter()
    if not char or not hum or not hrp then return end
    if hum.Health <= 0 then return end
    if spectateActive and stopSpectate then stopSpectate() end

    hrp.Anchored = true
    savedAutoRotate = hum.AutoRotate
    hum.AutoRotate = false
    setCharacterVisible(char)

    Camera.CameraSubject = hum
    Camera.CameraType   = Enum.CameraType.Scriptable

    local camCF = Camera.CFrame
    freecamPos   = camCF.Position
    local rx, ry = camCF:ToEulerAnglesYXZ()
    freecamPitch = rx
    freecamYaw   = ry

    freecamActive = true
    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter

    freecamStatus.Text = "Status: ON"
    freecamBtn.Text = "Disable Freecam"
    freecamBtn.BackgroundColor3 = Color3.fromRGB(100, 50, 50)
    freecamIndicator.Visible = true
    updateSpeedDisplay()
end

function disableFreecam()
    if not freecamActive then return end
    freecamActive = false

    local char, hum, hrp = getLocalCharacter()
    if char then
        if hrp and hrp.Parent then
            pcall(function() hrp.Anchored = false end)
        end
        if hum and hum.Parent then
            pcall(function() hum.AutoRotate = savedAutoRotate end)
            if hum.Health > 0 then
                Camera.CameraSubject = hum
            end
        end
    end

    restoreCharacterVisibility()

    Camera.CameraType = Enum.CameraType.Custom
    pcall(function()
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end)
    if not scriptDestroyed and freecamStatus and freecamStatus.Parent then
        freecamStatus.Text = "Status: OFF"
        freecamBtn.Text = "Enable Freecam"
        freecamBtn.BackgroundColor3 = Color3.fromRGB(50, 55, 60)
        freecamIndicator.Visible = false
    end
end

local function updateFreecam(dt)
    if Camera.CameraType ~= Enum.CameraType.Scriptable then
        Camera.CameraType = Enum.CameraType.Scriptable
    end
    if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    end

    -- Réapplique la visibilité (Roblox peut la réinitialiser en 1ʳᵉ personne)
    for part, _ in pairs(savedTransparency) do
        if part and part.Parent and part:IsA("BasePart") then
            part.LocalTransparencyModifier = 0
        end
    end

    local delta = UserInputService:GetMouseDelta()
    freecamYaw   = freecamYaw   - delta.X * FREECAM_SENSITIVITY
    freecamPitch = math.clamp(freecamPitch - delta.Y * FREECAM_SENSITIVITY,
        -math.rad(89), math.rad(89))

    local rot = CFrame.fromEulerAnglesYXZ(freecamPitch, freecamYaw, 0)

    local move = Vector3.new(0, 0, 0)
    if isDown(Enum.KeyCode.W) then move = move + rot.LookVector  end
    if isDown(Enum.KeyCode.S) then move = move - rot.LookVector  end
    if isDown(Enum.KeyCode.D) then move = move + rot.RightVector end
    if isDown(Enum.KeyCode.A) then move = move - rot.RightVector end
    if isDown(Enum.KeyCode.E) or isDown(Enum.KeyCode.Space)     then
        move = move + Vector3.new(0, 1, 0)
    end
    if isDown(Enum.KeyCode.Q) or isDown(Enum.KeyCode.LeftShift) then
        move = move - Vector3.new(0, 1, 0)
    end
    if move.Magnitude > 0 then move = move.Unit end

    local speed = freecamSpeed
    if isDown(Enum.KeyCode.LeftAlt)     then speed = speed * 3    end
    if isDown(Enum.KeyCode.LeftControl) then speed = speed * 0.25 end

    freecamPos = freecamPos + move * speed * dt
    Camera.CFrame = CFrame.new(freecamPos) * rot
end

-- ============================================================
-- SPECTATE
-- ============================================================
local function smoothed(alpha, dt)
    return 1 - (1 - alpha) ^ (dt * 60)
end

function updateSpectateCamera(dt)
    if not spectateActive or not spectateTarget then return end

    if Camera.CameraType ~= Enum.CameraType.Scriptable then
        Camera.CameraType = Enum.CameraType.Scriptable
    end

    local orbiting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if orbiting then
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end
        local delta = UserInputService:GetMouseDelta()
        spectateYaw = spectateYaw - delta.X * SPECTATE_SENSITIVITY
        spectateElevation = math.clamp(
            spectateElevation - delta.Y * SPECTATE_SENSITIVITY,
            -math.rad(89), math.rad(89))
    else
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end

    local char = spectateTarget.Character
    if not char then
        if spectateIndicator and spectateIndicator.Parent then
            spectateIndicator.Text = "SPECTATE: " .. spectateTarget.DisplayName .. " (hors portée)"
        end
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        if spectateIndicator and spectateIndicator.Parent then
            spectateIndicator.Text = "SPECTATE: " .. spectateTarget.DisplayName .. " (cible morte)"
        end
        return
    end

    local anchor = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not anchor then return end

    local heightOffset = math.max(1, spectateDistance * 0.15)
    local targetPos = anchor.Position + Vector3.new(0, heightOffset, 0)

    local rot = CFrame.fromEulerAnglesYXZ(-spectateElevation, spectateYaw, 0)
    local camPos = targetPos + rot * Vector3.new(0, 0, spectateDistance)
    local goalCF = CFrame.lookAt(camPos, targetPos)

    -- === FIX v9 : utilise currentOrbitCF persistante (pas Camera.CFrame) ===
    -- Sinon, si le jeu reset Camera.CFrame entre 2 frames, le lerp ne
    -- progresse jamais. Avec notre propre état, il progresse toujours.
    if not currentOrbitCF then
        currentOrbitCF = goalCF
    else
        currentOrbitCF = currentOrbitCF:Lerp(goalCF, smoothed(SPECTATE_SMOOTH, dt))
    end
    Camera.CFrame = currentOrbitCF

    if spectateIndicator and spectateIndicator.Parent then
        local hint = orbiting and "relâche clic droit pour cliquer" or "clic droit = orbite"
        spectateIndicator.Text = string.format(
            "SPECTATE: %s  (dist %d)  — %s",
            spectateTarget.DisplayName, math.floor(spectateDistance), hint)
    end
end

function startSpectate(player)
    if scriptDestroyed then return end
    if not player or player == LocalPlayer then return end
    if freecamActive and disableFreecam then disableFreecam() end

    spectateTarget = player
    spectateActive = true
    currentOrbitCF = nil   -- force le snap au premier frame
    Camera.CameraType = Enum.CameraType.Scriptable
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    releaseTextFocus()

    local char = player.Character
    local anchor = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
    if anchor then
        local heightOffset = math.max(1, spectateDistance * 0.15)
        local targetPos = anchor.Position + Vector3.new(0, heightOffset, 0)
        local offset = Camera.CFrame.Position - targetPos
        if offset.Magnitude > 0.5 then
            local dir = offset.Unit
            spectateElevation = math.asin(math.clamp(dir.Y, -1, 1))
            spectateYaw = math.atan2(dir.X, dir.Z)
            spectateDistance = math.clamp(offset.Magnitude, SPECTATE_MIN_DIST, SPECTATE_MAX_DIST)
        else
            spectateYaw = 0
            spectateElevation = 0
        end
    else
        spectateYaw = 0
        spectateElevation = 0
    end

    spectateStopBtn.Visible = true
    spectateIndicator.Visible = true
    quickStopBtn.Visible = true
    updateSpectateCamera(1/60)
end

function stopSpectate()
    if not spectateActive then return end
    local now = os.clock()
    if now - lastStopTime < STOP_DEBOUNCE then return end
    lastStopTime = now

    spectateActive = false
    spectateTarget = nil
    currentOrbitCF = nil

    local char, hum = getLocalCharacter()
    if char and hum and hum.Health > 0 then
        Camera.CameraSubject = hum
    end
    Camera.CameraType = Enum.CameraType.Custom
    pcall(function()
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end)

    if not scriptDestroyed then
        if spectateStopBtn and spectateStopBtn.Parent then spectateStopBtn.Visible = false end
        if spectateIndicator and spectateIndicator.Parent then spectateIndicator.Visible = false end
        if quickStopBtn and quickStopBtn.Parent then quickStopBtn.Visible = false end
    end
end

-- ============================================================
-- BOUTONS GUI
-- ============================================================
track(freecamBtn.MouseButton1Click:Connect(function()
    if freecamActive then disableFreecam() else enableFreecam() end
end))
track(spectateStopBtn.MouseButton1Click:Connect(stopSpectate))
track(quickStopBtn.MouseButton1Click:Connect(stopSpectate))

track(speedMinus.MouseButton1Click:Connect(function()
    freecamSpeed = math.max(5, freecamSpeed - 10); updateSpeedDisplay()
end))
track(speedPlus.MouseButton1Click:Connect(function()
    freecamSpeed = math.min(500, freecamSpeed + 10); updateSpeedDisplay()
end))

track(closeBtn.MouseButton1Click:Connect(function()
    if destroyScript then destroyScript() end
end))

-- ============================================================
-- INPUTS CLAVIER
-- ============================================================
track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if scriptDestroyed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        keysDown[input.KeyCode] = true
        if spectateActive and (input.KeyCode == Enum.KeyCode.Escape
            or input.KeyCode == Enum.KeyCode.Backspace) then
            stopSpectate()
            return
        end
    end
    if gameProcessed then return end

    local key = input.KeyCode
    if key == Enum.KeyCode.F then
        if freecamActive then disableFreecam() else enableFreecam() end
    elseif key == Enum.KeyCode.V then
        panel.Visible = not panel.Visible
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        keysDown[input.KeyCode] = nil
    end
end))

track(UserInputService.WindowFocusReleased:Connect(function()
    keysDown = {}
end))

-- ============================================================
-- MOLETTE
-- ============================================================
track(UserInputService.InputChanged:Connect(function(input)
    if scriptDestroyed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
    if freecamActive then
        freecamSpeed = math.clamp(freecamSpeed + input.Position.Z * 5, 5, 500)
        updateSpeedDisplay()
    elseif spectateActive then
        spectateDistance = math.clamp(
            spectateDistance - input.Position.Z * 2,
            SPECTATE_MIN_DIST, SPECTATE_MAX_DIST)
    end
end))

