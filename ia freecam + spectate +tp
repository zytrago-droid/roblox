destroyScript = function()
    if scriptDestroyed then return end
    scriptDestroyed = true

    pcall(function() if freecamActive then disableFreecam() end end)
    pcall(function() if spectateActive then stopSpectate() end end)

    pcall(function()
        local char, hum = getLocalCharacter()
        if char and hum and hum.Parent then
            hum.AutoRotate = savedAutoRotate
            if hum.Health > 0 then Camera.CameraSubject = hum end
            Camera.CameraType = Enum.CameraType.Custom
        end
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end)

    pcall(function()
        local _, _, hrp = getLocalCharacter()
        if hrp and hrp.Parent then hrp.Anchored = false end
    end)
    pcall(restoreCharacterVisibility)
    pcall(function() RunService:UnbindFromRenderStep(RENDER_STEP_NAME) end)

    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    connections = {}

    keysDown = {}
    playerRows = {}
    thumbnailCache = {}
    thumbLoading = {}
    savedTransparency = {}
    spectateTarget = nil
    currentOrbitCF = nil
    spectateYaw = 0
    spectateElevation = 0
    freecamActive = false
    spectateActive = false
    isDragging = false
    dragStart = nil
    dragStartPos = nil
    isResizing = false
    resizeStart = nil
    resizeStartSize = nil
    listeningForBind = false

    -- Le ScreenGui contient la signature → sa destruction la retire aussi.
    pcall(function() if screenGui then screenGui:Destroy() end end)
    screenGui = nil
    signatureLabel = nil

    print("[Camera Tools] Closed.")
end
